+/*****************************************************************************\
+ *  monthly_quota.h - controller-side monthly GPU quota admission ledger
+ *
+ *  This module is deliberately private to slurmctld.  It is disabled unless
+ *  the exact SlurmctldParameters token MonthlyGpuQuota is present.
+\*****************************************************************************/
+
+#ifndef _HAVE_SLURMCTLD_MONTHLY_QUOTA_H
+#define _HAVE_SLURMCTLD_MONTHLY_QUOTA_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <sys/types.h>
+
+#include "src/common/list.h"
+
+struct job_record;
+extern int monthly_quota_bind1(uid_t uid, const char *request, uint32_t job_id);
+extern int monthly_quota_reserve1(uid_t uid, const char *request, uint32_t tier,
+				  uint32_t gpu, uint32_t minutes, uint64_t *amount);
+extern int monthly_quota_cancel1(uid_t uid, const char *request);
+extern int monthly_quota_reserve1_lookup(uid_t uid, const char *request,
+					 uint32_t *month, uint32_t *tier,
+					 uint32_t *gpu, uint32_t *minutes,
+					 uint64_t *amount);
+
+/* Ordered user consumption tiers; unknown must never be treated as normal. */
+typedef enum {
+	MONTHLY_QUOTA_DEBUG = 0,
+	MONTHLY_QUOTA_IMPORTANT = 1,
+	MONTHLY_QUOTA_NORMAL = 2,
+	MONTHLY_QUOTA_EXHAUSTED = 3
+} monthly_quota_tier_t;
+
+/* A projected view, not an allocation authorization. `wal_sequence` is a
+ * durable event position, not a cache key for continuously changing usage. */
+typedef struct {
+	uint64_t sec;
+	uint32_t nsec;
+} monthly_quota_amount_t;
+
+typedef struct {
+	uid_t uid;
+	uint32_t month; /* Asia/Shanghai YYYYMM */
+	uint64_t observed_sec;
+	uint32_t observed_nsec;
+	uint64_t wal_sequence;
+	monthly_quota_tier_t tier;
+	monthly_quota_amount_t used, granted, capacity, remaining, overage;
+	uint64_t active_gpu_count;
+	uint32_t active_allocation_count;
+} monthly_quota_snapshot_t;
+
+/* Version 2 is only available after a verified selectable ledger cutover. */
+typedef struct {
+	uint32_t month, active_allocation_count;
+	uint64_t active_gpu_count, observed_sec, wal_sequence;
+	uint32_t observed_nsec;
+	monthly_quota_amount_t granted, used[3], overage;
+} monthly_quota_snapshot2_t;
+extern int monthly_quota_snapshot2(uid_t uid, monthly_quota_snapshot2_t *out);
+/* Caller must hold Slurm job write lock; disabled in ordinary builds. */
+extern int monthly_quota_selectable_cutover(list_t *jobs);
+
+/* Call only inside slurmctld. Future transport must authenticate the caller.
+ * Returns -1 and leaves output unchanged when disabled/unhealthy/unknown. */
+extern int monthly_quota_inherited_witness_fd(void);
+extern int monthly_quota_snapshot(uid_t uid, monthly_quota_snapshot_t *out);
+
+/* Atomic read-only snapshot at a supplied realtime value. Failure leaves
