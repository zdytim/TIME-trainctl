+		}
+		unlock_slurmctld(grant_lock);
+		if (!rc) {
+			queue_job_scheduler();
+			snprintf(reply, sizeof(reply), "OK\n");
+		}
+	}
+	if (rc) snprintf(reply, sizeof(reply), "ERROR unavailable_or_invalid\n");
+	length = 0;
+	while (length < strlen(reply)) {
+		n = send(fd, reply + length, strlen(reply) - length, MSG_NOSIGNAL);
+		if (n < 0 && errno == EINTR) continue;
+		if (n <= 0) break; /* caller must treat an incomplete reply as unknown */
+		length += (size_t)n;
+	}
+}
+
+static void *serve(void *unused)
+{
+	struct pollfd fds[2] = {{0}};
+	(void)unused;
+	fds[0].fd = listener; fds[0].events = POLLIN;
+	fds[1].fd = wakepipe[0]; fds[1].events = POLLIN;
+	for (;;) {
+		int fd, ready = poll(fds, 2, -1);
+		if (ready < 0 && errno == EINTR) continue;
+		if (ready < 0) break;
+		if (fds[1].revents) break;
+		if (fds[0].revents & (POLLERR | POLLHUP | POLLNVAL)) break;
+		if (!(fds[0].revents & POLLIN)) continue;
+		fd = accept4(listener, NULL, NULL, SOCK_CLOEXEC);
+		if (fd >= 0) { handle(fd); close(fd); }
+	}
+	return NULL;
+}
+
+/* Only remove an owned, private socket that refuses connections and has
+ * not changed identity. The state directory is owned by the service user;
+ * an adversary with that same UID remains outside this trust boundary. */
+static int recover_stale_socket(struct sockaddr_un *addr)
+{
+	struct stat before, after;
+	int probe, result, saved_errno;
+	if (lstat(socket_path, &before))
+		return errno == ENOENT ? 0 : -1;
+	if (!monthly_quota_control_recovery_ready() || !S_ISSOCK(before.st_mode) ||
+	    before.st_uid != geteuid() || (before.st_mode & 0077)) return -1;
+	probe = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+	if (probe < 0) return -1;
+	result = connect(probe, (struct sockaddr *)addr, sizeof(*addr));
+	saved_errno = errno;
+	close(probe);
+	if (result == 0 || saved_errno != ECONNREFUSED) return -1;
+	if (lstat(socket_path, &after) || !S_ISSOCK(after.st_mode) ||
+	    after.st_uid != geteuid() || (after.st_mode & 0077) ||
+	    after.st_dev != before.st_dev || after.st_ino != before.st_ino) return -1;
+	if (unlink(socket_path)) return -1;
+	info("monthly quota: removed verified stale control socket");
+	return 0;
+}
+
+int monthly_quota_control_start(void)
+{
+	struct sockaddr_un addr = {0};
+	struct stat dir, sock;
+	int rc;
+	if (!monthly_quota_enabled()) return 0;
+	if (started || !slurm_conf.state_save_location ||
+	    lstat(slurm_conf.state_save_location, &dir) || !S_ISDIR(dir.st_mode) ||
+	    dir.st_uid != geteuid() || (dir.st_mode & 0022)) return -1;
+	rc = snprintf(socket_path, sizeof(socket_path), "%s/time-quota.sock",
+		      slurm_conf.state_save_location);
+	if (rc < 0 || (size_t)rc >= sizeof(socket_path)) return -1;
+	addr.sun_family = AF_UNIX;
+	memcpy(addr.sun_path, socket_path, strlen(socket_path) + 1);
+	if (recover_stale_socket(&addr)) return -1;
+	listener = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (listener < 0) return -1;
+	if (bind(listener, (struct sockaddr *)&addr, sizeof(addr))) goto fail;
+	if (lstat(socket_path, &sock) || !S_ISSOCK(sock.st_mode) ||
+	    sock.st_uid != geteuid()) goto fail_path;
+	socket_dev = sock.st_dev; socket_ino = sock.st_ino;
+	if (chmod(socket_path, 0600) || listen(listener, 8) || pipe2(wakepipe, O_CLOEXEC))
+		goto fail_path;
+	if (pthread_create(&thread, NULL, serve, NULL)) goto fail_path;
+	started = true;
+	return 0;
+fail_path:
+	if (!lstat(socket_path, &sock) && S_ISSOCK(sock.st_mode) &&
+	    sock.st_uid == geteuid() && sock.st_dev == socket_dev && sock.st_ino == socket_ino)
+		unlink(socket_path);
+fail:
+	if (wakepipe[0] >= 0) close(wakepipe[0]);
+	if (wakepipe[1] >= 0) close(wakepipe[1]);
+	wakepipe[0] = wakepipe[1] = -1;
+	close(listener); listener = -1;
+	return -1;
+}
+
+void monthly_quota_control_stop(void)
+{
+	struct stat sock;
+	ssize_t sent;
+	if (!started) return;
+	do { sent = write(wakepipe[1], "x", 1); } while (sent < 0 && errno == EINTR);
+	if (sent != 1) { close(wakepipe[1]); wakepipe[1] = -1; }
+	pthread_join(thread, NULL);
+	close(listener); close(wakepipe[0]);
+	if (wakepipe[1] >= 0) close(wakepipe[1]);
+	listener = wakepipe[0] = wakepipe[1] = -1;
+	if (!lstat(socket_path, &sock) && S_ISSOCK(sock.st_mode) &&
+	    sock.st_dev == socket_dev && sock.st_ino == socket_ino && sock.st_uid == geteuid())
+		unlink(socket_path);
+	started = false;
+}
