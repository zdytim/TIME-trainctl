+static int number(const char *s, uint64_t *out)
+{
+	char *end;
+	unsigned long long value;
+	const unsigned char *p = (const unsigned char *)s;
+	if (!*p) return -1;
+	for (; *p; p++) if (*p < '0' || *p > '9') return -1;
+	errno = 0;
+	value = strtoull(s, &end, 10);
+	if (errno || *end) return -1;
+	*out = value;
+	return 0;
+}
+
+static void handle(int fd)
+{
+	struct ucred peer;
+	socklen_t peer_len = sizeof(peer);
+	struct timeval timeout = {2, 0};
+	char buf[512], reply[1024], *part[7], *save, *p;
+	size_t length = 0, count = 0;
+	ssize_t n;
+	uint64_t uid, month, sec;
+	uint64_t tier_num, gpu_num, minutes_num, amount;
+	uint64_t bind_job;
+	uint32_t result_month, result_tier, result_gpu, result_minutes;
+	int rc = -1;
+	monthly_quota_snapshot_t view;
+	monthly_quota_snapshot2_t view2;
+	slurmctld_lock_t config_lock = {READ_LOCK, NO_LOCK, NO_LOCK, NO_LOCK, NO_LOCK};
+	slurmctld_lock_t grant_lock = {READ_LOCK, WRITE_LOCK, NO_LOCK, NO_LOCK, NO_LOCK};
+
+	if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &peer, &peer_len) ||
+	    peer_len != sizeof(peer) || peer.uid != 0)
+		return;
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+	while (length < sizeof(buf) - 1) {
+		n = recv(fd, buf + length, 1, 0);
+		if (n < 0 && errno == EINTR) continue;
+		if (n != 1) return;
+		if (buf[length++] == '\n') break;
+	}
+	if (!length || buf[length - 1] != '\n' || memchr(buf, '\0', length)) return;
+	buf[length - 1] = '\0';
+	p = strtok_r(buf, " ", &save);
+	while (p && count < 7) { part[count++] = p; p = strtok_r(NULL, " ", &save); }
+	if (p || count < 2 || number(part[1], &uid) || uid > UINT32_MAX) return;
+	if (count == 3 && !strcmp(part[0], "CANCEL1")) {
+		lock_slurmctld(grant_lock);
+		rc = monthly_quota_cancel1((uid_t)uid, part[2]);
+		unlock_slurmctld(grant_lock);
+		if (!rc) snprintf(reply, sizeof(reply), "OK\n");
+	} else if (count == 4 && !strcmp(part[0], "BIND1") &&
+	    !number(part[3], &bind_job) && bind_job > 0 && bind_job <= UINT32_MAX) {
+		assoc_mgr_lock_t tres_lock = { .tres = READ_LOCK };
+		lock_slurmctld(grant_lock);
+		assoc_mgr_lock(&tres_lock);
+		rc = monthly_quota_bind1((uid_t)uid, part[2], bind_job);
+		assoc_mgr_unlock(&tres_lock);
+		unlock_slurmctld(grant_lock);
+		if (!rc) snprintf(reply, sizeof(reply), "OK\n");
+	} else if (count == 6 && !strcmp(part[0], "RESERVE1") &&
+	    !number(part[3], &tier_num) && tier_num < 3 &&
+	    !number(part[4], &gpu_num) && gpu_num > 0 && gpu_num <= UINT32_MAX &&
+	    !number(part[5], &minutes_num) && minutes_num > 0 && minutes_num <= UINT32_MAX) {
+		lock_slurmctld(grant_lock);
+		rc = monthly_quota_reserve1((uid_t)uid, part[2], tier_num, gpu_num,
+					    minutes_num, &amount);
+		unlock_slurmctld(grant_lock);
+		if (!rc) snprintf(reply, sizeof(reply), "OK %" PRIu64 "\n", amount);
+	} else if (count == 3 && !strcmp(part[0], "RESERVE1_GET")) {
+		lock_slurmctld(config_lock);
+		rc = monthly_quota_reserve1_lookup((uid_t)uid, part[2], &result_month,
+						   &result_tier, &result_gpu,
+						   &result_minutes, &amount);
+		unlock_slurmctld(config_lock);
+		if (!rc) snprintf(reply, sizeof(reply), "OK %u %u %u %u %" PRIu64 "\n",
+				  result_month, result_tier, result_gpu, result_minutes, amount);
+	} else if (count == 2 && !strcmp(part[0], "SNAP")) {
+		lock_slurmctld(config_lock);
+		rc = monthly_quota_snapshot((uid_t)uid, &view);
+		unlock_slurmctld(config_lock);
+		if (!rc) {
+			snprintf(reply, sizeof(reply),
+				 "OK %u %u %" PRIu64 " %u %" PRIu64 " %u "
+				 "%" PRIu64 " %u %" PRIu64 " %u %" PRIu64 " %u "
+				 "%" PRIu64 " %u %" PRIu64 " %u %" PRIu64 "\n",
+				 view.month, (unsigned)view.tier, view.used.sec, view.used.nsec,
+				 view.granted.sec, view.granted.nsec, view.capacity.sec, view.capacity.nsec,
+				 view.remaining.sec, view.remaining.nsec, view.overage.sec, view.overage.nsec,
+				 view.active_gpu_count, view.active_allocation_count,
+				 view.observed_sec, view.observed_nsec, view.wal_sequence);
+		}
+	} else if (count == 2 && !strcmp(part[0], "SNAP2")) {
+		lock_slurmctld(config_lock);
+		rc = monthly_quota_snapshot2((uid_t)uid, &view2);
+		unlock_slurmctld(config_lock);
+		if (!rc) {
+			snprintf(reply, sizeof(reply),
+				 "OK 2 %u %" PRIu64 " %u %" PRIu64 " %u %" PRIu64 " %u "
+				 "%" PRIu64 " %u %" PRIu64 " %u %" PRIu64 " %u %" PRIu64 " %u %" PRIu64 "\n",
+				 view2.month, view2.granted.sec, view2.granted.nsec,
+				 view2.used[0].sec, view2.used[0].nsec,
+				 view2.used[1].sec, view2.used[1].nsec,
+				 view2.used[2].sec, view2.used[2].nsec,
+				 view2.overage.sec, view2.overage.nsec,
+				 view2.observed_sec, view2.observed_nsec, view2.wal_sequence,
+				 view2.active_allocation_count, view2.active_gpu_count);
+		}
+	} else if (count == 2 && uid == 0 && !strcmp(part[0], "CUTOVER2_RESET_USAGE")) {
+		lock_slurmctld(grant_lock);
+		rc = monthly_quota_selectable_cutover(job_list);
+		unlock_slurmctld(grant_lock);
+		if (!rc) snprintf(reply, sizeof(reply), "OK\n");
+	} else if (count == 6 && !strcmp(part[0], "GRANT") &&
+		   !number(part[2], &month) && month <= UINT32_MAX &&
+		   !number(part[3], &sec)) {
+		time_t changed;
+		lock_slurmctld(grant_lock);
+		rc = monthly_quota_grant((uid_t)uid, (uint32_t)month, sec, part[4], part[5]);
+		if (!rc) {
+			changed = time(NULL);
+			if (changed != (time_t)-1)
