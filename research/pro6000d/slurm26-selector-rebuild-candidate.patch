+		memcpy(g->type_cnt_alloc, snap->type, snap->type_count * sizeof(uint64_t));
+	xfree(g->gres_used); g->gres_used = snap->used; snap->used = NULL;
 }
 
+/* Returns 0 for an unrelated selector call, 1 after a complete snapshot,
+ * -1 if a monthly GPU transaction cannot be proven safe before mutation. */
+static int _quota_gres_snapshot(job_record_t *job_ptr, bool new_alloc,
+				job_res_job_action_t action, quota_gres_snapshot_t *snap)
+{
+	job_resources_t *job = job_ptr->job_resrcs;
+	gres_state_t *req, *node_state;
+	gres_job_state_t *jg;
+	gres_node_state_t *ng;
+	list_itr_t *iter;
+	list_t *node_gres;
+	node_record_t *node;
+	part_res_record_t *part;
+	int index = 0, fit = 0;
+	if (!new_alloc || action != JOB_RES_ACTION_NORMAL || quota_rebuild_in_progress ||
+	    !slurm_conf.slurmctld_params || !xstrcasestr(slurm_conf.slurmctld_params, "MonthlyGpuQuota") ||
+	    (job_ptr->bit_flags & JOB_WAS_RUNNING) || !job_ptr->gres_list_req)
+		return 0;
+	iter = list_iterator_create(job_ptr->gres_list_req);
+	req = list_next(iter);
+	if (!req || req->plugin_id != gres_get_gpu_plugin_id()) { list_iterator_destroy(iter); return 0; }
+	list_iterator_destroy(iter);
+	if (list_count(job_ptr->gres_list_req) != 1 || !req->gres_data || !req->gres_name ||
+	    strcmp(req->gres_name, "gpu") || req->state_type != GRES_STATE_TYPE_JOB ||
+	    (req->config_flags & GRES_CONF_SHARED) || !job_ptr->details ||
+	    (job_ptr->details->whole_node & WHOLE_NODE_REQUIRED) || !job || !job->node_bitmap ||
+	    !job->cpus || !job->memory_allocated || job->nhosts != 1 ||
+	    bit_set_count(job->node_bitmap) != 1 || !job->cpus[0] || !job->memory_allocated[0]) {
+		error("quota transaction preflight: unsupported job resources whole=%u", job_ptr->details ? job_ptr->details->whole_node : 255);
+		return -1;
+	}
+	jg = req->gres_data;
+	if (jg->type_name || (jg->flags & GRES_CONF_SHARED)) return -1;
+	node = next_node_bitmap(job->node_bitmap, &index);
+	if (!node || !select_node_usage || !node->gres_list) return -1;
+	node_gres = select_node_usage[index].gres_list ? select_node_usage[index].gres_list : node->gres_list;
+	node_state = list_find_first(node_gres, gres_find_id, &req->plugin_id);
+	if (!node_state || !node_state->gres_data || !node_state->gres_name ||
+	    strcmp(node_state->gres_name, "gpu") || node_state->state_type != GRES_STATE_TYPE_NODE ||
+	    (node_state->config_flags & GRES_CONF_SHARED)) return -1;
+	ng = node_state->gres_data;
+	if (ng->no_consume || ng->alt_gres || !ng->gres_bit_alloc ||
+	    (ng->topo_cnt && !ng->topo_gres_cnt_alloc) ||
+	    (ng->type_cnt && !ng->type_cnt_alloc) ||
+	    !jg->gres_cnt_node_select || index >= jg->total_node_cnt ||
+	    (jg->gres_bit_select && jg->gres_bit_select[index] &&
+	     (bit_size(jg->gres_bit_select[index]) != bit_size(ng->gres_bit_alloc) ||
+	      bit_overlap_any(jg->gres_bit_select[index], ng->gres_bit_alloc) ||
+	      bit_set_count(jg->gres_bit_select[index]) != jg->gres_cnt_node_select[index])) ||
+	    (uint64_t)bit_set_count(ng->gres_bit_alloc) != ng->gres_cnt_alloc ||
+	    !jg->gres_cnt_node_select[index] || ng->gres_cnt_alloc > ng->gres_cnt_avail ||
+	    jg->gres_cnt_node_select[index] > ng->gres_cnt_avail - ng->gres_cnt_alloc ||
+	    select_node_usage[index].alloc_memory > node->real_memory ||
+	    job->memory_allocated[0] > node->real_memory - select_node_usage[index].alloc_memory) {
+		error("quota transaction preflight: GPU/selection state: no_consume=%u alt=%u bitmap=%u topo=%u topoalloc=%u type=%u typealloc=%u selected=%u count=%u totalnodes=%u", ng->no_consume, !!ng->alt_gres, !!ng->gres_bit_alloc, ng->topo_cnt, !!ng->topo_gres_cnt_alloc, ng->type_cnt, !!ng->type_cnt_alloc, !!jg->gres_bit_select, !!jg->gres_cnt_node_select, jg->total_node_cnt);
+		return -1;
+	}
+	/* Validate the only later error exit before touching GPU or memory. */
+	for (part = select_part_record; part && part->part_ptr != job_ptr->part_ptr; part = part->next) {}
+	if (!part || !part->num_rows) return -1;
+	if (part->rebuild_rows) part_data_build_row_bitmaps(part, NULL);
+	if (!part->row) fit = 1;
+	else for (int i = 0; i < part->num_rows; i++) if (job_res_fit_in_row(job, &part->row[i])) { fit = 1; break; }
+	if (!fit) return -1;
+	snap->node_gpu = ng; snap->node_state = node_state; snap->count = ng->gres_cnt_alloc;
+	snap->expected = jg->gres_cnt_node_select[index];
+	snap->bits = bit_copy(ng->gres_bit_alloc);
+	snap->topo_count = ng->topo_cnt; snap->type_count = ng->type_cnt;
+	snap->had_topo = ng->topo_gres_cnt_alloc != NULL;
+	if (snap->topo_count) {
+		snap->topo = xcalloc(snap->topo_count, sizeof(uint64_t));
+		memcpy(snap->topo, ng->topo_gres_cnt_alloc, snap->topo_count * sizeof(uint64_t));
+	}
+	if (snap->type_count) {
+		snap->type = xcalloc(snap->type_count, sizeof(uint64_t));
+		memcpy(snap->type, ng->type_cnt_alloc, snap->type_count * sizeof(uint64_t));
+	}
+	snap->used = xstrdup(ng->gres_used);
+	return 1;
+}
