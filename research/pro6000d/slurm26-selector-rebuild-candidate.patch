+/* Slurm sometimes logs malformed or overlapping bitmaps yet returns success.
+ * The snapshot is retained until the actual delta is proved exact. */
+static bool _quota_gres_delta_valid(job_record_t *job_ptr, quota_gres_snapshot_t *snap)
+{
+	gres_state_t *state;
+	gres_job_state_t *job_gpu;
+	gres_node_state_t *ng = snap->node_gpu;
+	list_itr_t *iter;
+	bitstr_t *merged = NULL, *bits;
+	bool valid = false, busy;
+	if (!job_ptr->gres_list_alloc || list_count(job_ptr->gres_list_alloc) != 1 ||
+	    !ng || ng->type_cnt != snap->type_count || ng->topo_cnt != snap->topo_count ||
+	    !ng->gres_bit_alloc || UINT64_MAX - snap->count < snap->expected ||
+	    ng->gres_cnt_alloc != snap->count + snap->expected) return false;
+	iter = list_iterator_create(job_ptr->gres_list_alloc);
+	state = list_next(iter);
+	if (!state || state->plugin_id != gres_get_gpu_plugin_id() ||
+	    state->state_type != GRES_STATE_TYPE_JOB || !state->gres_name ||
+	    strcmp(state->gres_name, "gpu") || !state->gres_data || (state->config_flags & GRES_CONF_SHARED)) {
+		list_iterator_destroy(iter); return false;
+	}
+	job_gpu = state->gres_data;
+	list_iterator_destroy(iter);
+	if (job_gpu->type_name || (job_gpu->flags & GRES_CONF_SHARED) || job_gpu->node_cnt != 1 ||
+	    !job_gpu->gres_cnt_node_alloc || !job_gpu->gres_bit_alloc || !(bits = job_gpu->gres_bit_alloc[0]) ||
+	    bit_size(bits) != bit_size(snap->bits) || bit_size(bits) != bit_size(ng->gres_bit_alloc) ||
+	    job_gpu->gres_cnt_node_alloc[0] != snap->expected || bit_set_count(bits) != snap->expected ||
+	    bit_overlap_any(bits, snap->bits)) return false;
+	merged = bit_copy(snap->bits); bit_or(merged, bits);
+	if (!bit_equal(merged, ng->gres_bit_alloc)) goto done;
+	busy = gres_use_busy_dev(snap->node_state, 0);
+	for (int i = 0; i < snap->topo_count; i++) {
+		uint64_t delta;
+		if (!snap->topo || !ng->topo_gres_cnt_alloc || !ng->topo_gres_bitmap ||
+		    !ng->topo_gres_bitmap[i] || bit_size(ng->topo_gres_bitmap[i]) != bit_size(bits)) goto done;
+		delta = (busy && snap->topo[i] == 0) ? 0 : bit_overlap(bits, ng->topo_gres_bitmap[i]);
+		if (UINT64_MAX - snap->topo[i] < delta || ng->topo_gres_cnt_alloc[i] != snap->topo[i] + delta) goto done;
+	}
+	for (int j = 0; j < snap->type_count; j++) {
+		uint64_t delta = 0;
+		if (!snap->type || !ng->type_cnt_alloc) goto done;
+		for (int i = 0; i < snap->topo_count; i++) {
+			if (!ng->topo_type_name || !ng->topo_type_id || !ng->type_name || !ng->type_id ||
+			    !ng->topo_type_name[i] || !ng->type_name[j]) continue;
+			if (ng->topo_type_id[i] == ng->type_id[j] && !(busy && snap->topo[i] == 0))
+				delta += bit_overlap(bits, ng->topo_gres_bitmap[i]);
+		}
+		if (UINT64_MAX - snap->type[j] < delta || ng->type_cnt_alloc[j] != snap->type[j] + delta) goto done;
+	}
+	valid = true;
+done:
+	FREE_NULL_BITMAP(merged);
+	return valid;
+}
