+	if (!node)
+		return -1;
+	pthread_mutex_lock(&mq_lock);
+	active = _find_active_job(job_ptr->job_id);
+	if (mq_healthy && active && active->committed && active->identity_bound &&
+	    active->sluid && active->sluid == job_ptr->step_id.sluid &&
+	    active->uid == job_ptr->user_id && job_ptr->details &&
+	    job_ptr->details->submit_time > 0 &&
+	    active->submit_sec == (uint64_t)job_ptr->details->submit_time &&
+	    active->restart_count == job_ptr->restart_cnt &&
+	    !time_parse_job_marker(job_ptr->comment, marker, &tier) &&
+	    !strcmp(marker, active->marker_id) && tier == active->selected_tier)
+		gpu = active->gpu_count;
