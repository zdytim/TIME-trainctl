+/* Before configuration sync can rewrite or fail a restored job, quarantine
+ * any run whose durable ledger says termination has begun or completed. */
+void monthly_quota_quarantine_restored(list_t *jobs)
+{
+	list_itr_t *iterator;
+	job_record_t *job_ptr;
+	mq_active_record_t *active;
+	mq_reserve1_t *entry;
+	char marker[33];
+	enum time_tier selected;
 
+	if (!jobs)
+		return;
+	pthread_mutex_lock(&mq_lock);
+	(void) _ensure_module_locked();
+	if (!mq_enabled || (mq_healthy && mq_reconciled))
+		goto done;
+	iterator = list_iterator_create(jobs);
+	while ((job_ptr = list_next(iterator))) {
+		bool quarantine = false;
+		if (!IS_JOB_RUNNING(job_ptr) && !IS_JOB_SUSPENDED(job_ptr) &&
+		    !IS_JOB_COMPLETING(job_ptr))
+			continue;
+		active = _find_active_job(job_ptr->job_id);
+		if (active && (!active->committed || active->release_started))
+			quarantine = true;
+		for (entry = mq_reserves; !quarantine && entry; entry = entry->next)
+			if (entry->job_id == job_ptr->job_id && entry->terminal == 2)
+				quarantine = true;
+		if ((!mq_healthy || mq_fd < 0) &&
+		    (!time_parse_job_marker(job_ptr->comment, marker, &selected) ||
+		     job_ptr->gres_list_req || job_ptr->gres_list_alloc))
+			quarantine = true;
+		if (quarantine)
+			_defer_job_locked(job_ptr);
+	}
+	list_iterator_destroy(iterator);
+done:
+	pthread_mutex_unlock(&mq_lock);
+}
+
+/* During startup preserve managed COMPLETING jobs for explicit recovery.
+ * The normal path would repeat ENDING and send another node termination.
+ * An unavailable ledger cannot prove a GRES job safe to deallocate. */
+bool monthly_quota_defer_recovered_completing(struct job_record *job_ptr)
+{
+	bool defer = false;
+	mq_reserve1_t *entry;
+	char marker[33];
+	enum time_tier selected;
+
+	if (!job_ptr || !IS_JOB_COMPLETING(job_ptr))
+		return false;
+	pthread_mutex_lock(&mq_lock);
+	(void) _ensure_module_locked();
+	if (!mq_enabled)
+		goto done;
+	/* Reconfiguration can also revisit COMPLETING.  A live managed
+	 * allocation must never be sent through deallocation twice. */
+	if (_find_active_job(job_ptr->job_id)) {
+		defer = true;
+		goto done;
+	}
+	if (mq_reconciled && mq_healthy)
+		goto done;
+	/* With no trustworthy ledger, preserve managed and GRES-bearing jobs;
+	 * unrelated CPU-only completions retain Slurm's normal cleanup. */
+	if (!time_parse_job_marker(job_ptr->comment, marker, &selected) ||
+	    ((!mq_healthy || mq_fd < 0) &&
+	     (job_ptr->gres_list_req || job_ptr->gres_list_alloc))) {
+		defer = true;
+		goto done;
+	}
+	for (entry = mq_reserves; entry; entry = entry->next) {
+		if (entry->job_id == job_ptr->job_id && entry->terminal) {
+			defer = true;
+			break;
+		}
+	}
+done:
+	/* Only startup's reconstructed allocation needs the epilog RPC held.
+	 * A live reconfiguration has already executed normal deallocation. */
+	if (defer && !mq_reconciled)
+		_defer_job_locked(job_ptr);
+	pthread_mutex_unlock(&mq_lock);
+	return defer;
+}
