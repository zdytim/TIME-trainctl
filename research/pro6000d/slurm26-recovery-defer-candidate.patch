+/* Pin the allocation's device-index interpretation to the same root-owned
+ * GRES configuration across controller and node restarts. */
+static int _hash_gres_config(char hex[65])
+{
+	char *path = get_extra_conf_path("gres.conf");
+	unsigned char digest[SHA256_DIGEST_LENGTH];
+	char *buffer = NULL, *cursor, *line;
+	static const char digits[] = "0123456789abcdef";
+	struct stat before, after;
+	SHA256_CTX ctx;
+	ssize_t n;
+	size_t used = 0;
+	int fd, rc = -1;
+	if (!path) return -1;
+	fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	xfree(path);
+	if (fd < 0) return -1;
+	if (fstat(fd, &before) || !S_ISREG(before.st_mode) || before.st_uid != 0 ||
+	    (before.st_mode & 0022) || before.st_nlink != 1 || before.st_size <= 0 ||
+	    before.st_size > 1024 * 1024 || SHA256_Init(&ctx) != 1) goto done;
+	buffer = xmalloc((size_t)before.st_size + 1);
+	while (used < (size_t)before.st_size) {
+		n = read(fd, buffer + used, (size_t)before.st_size - used);
+		if (n < 0 && errno == EINTR) continue;
+		if (n <= 0) goto done;
+		used += n;
+	}
+	if (memchr(buffer, '\0', used) || SHA256_Update(&ctx, buffer, used) != 1) goto done;
+	buffer[used] = '\0'; cursor = buffer;
+	while ((line = strsep(&cursor, "\n"))) {
+		while (*line && isspace((unsigned char)*line)) line++;
+		if (!strncasecmp(line, "include", 7) &&
+		    (line[7] == '=' || isspace((unsigned char)line[7]))) goto done;
+	}
+	if (fstat(fd, &after) || before.st_dev != after.st_dev ||
+	    before.st_ino != after.st_ino || before.st_size != after.st_size ||
+	    before.st_mtim.tv_sec != after.st_mtim.tv_sec || before.st_mtim.tv_nsec != after.st_mtim.tv_nsec ||
+	    SHA256_Final(digest, &ctx) != 1) goto done;
+	for (int i = 0; i < SHA256_DIGEST_LENGTH; i++) {
+		hex[2*i] = digits[digest[i] >> 4]; hex[2*i+1] = digits[digest[i] & 15];
+	}
+	hex[64] = '\0'; rc = 0;
+done:
+	xfree(buffer);
+	close(fd);
+	return rc;
+}
