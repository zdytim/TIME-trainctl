+		if (!job->details || !job->part_ptr) { ok = false; break; }
+		running++;
+		if (job->details->share_res == 0) no_share++;
+		owner = (job->details->whole_node & WHOLE_NODE_USER) ||
+			(job->part_ptr->flags & PART_FLAG_EXCLUSIVE_USER);
+		if (owner) {
+			if (node->owner != job->user_id) { ok = false; break; }
+			owners++;
+		}
+	}
+	list_iterator_destroy(it);
