+			if (!active->identity_bound || !active->reservation_bound ||
+			    !active->sluid || !reservation || reservation->terminal ||
+			    reservation->job_id != active->job_id ||
+			    reservation->generation != active->generation ||
+			    reservation->tier != active->selected_tier ||
+			    _time_cmp(&active->proof_at, &active->anchor) < 0) {
+				_mark_unhealthy("recovery proof or reservation identity mismatch");
+				settled = -1;
+				goto done;
+			}
+			if (!earliest || _time_cmp(&active->proof_at, &earliest->proof_at) < 0 ||
+			    (!_time_cmp(&active->proof_at, &earliest->proof_at) &&
+			     active->generation < earliest->generation))
+				earliest = active;
+		}
+		if (!earliest)
+			goto done;
+		for (other = mq_active; other; other = other->next)
+			if (_time_cmp(&other->anchor, &earliest->proof_at) > 0) {
+				_mark_unhealthy("cleanup proof predates settled allocation anchor");
+				settled = -1;
+				goto done;
+			}
+		reservation = _reserve1_find(earliest->uid, earliest->marker_id);
+		if (_settle_all(&earliest->proof_at) ||
+		    _append_event("RELEASE2|%u|%" PRIu64 "|%" PRIu64 "|%u",
+				  earliest->job_id, earliest->generation,
+				  earliest->proof_at.sec, earliest->proof_at.nsec)) {
+			_mark_unhealthy("recovery settlement could not be persisted");
+			settled = -1;
+			goto done;
+		}
+		_reserve1_copy_final(reservation, earliest);
+		_reserve1_finish(reservation, 2, earliest->sluid);
+		_remove_active(earliest);
+		settled++;
+	}
+done:
+	pthread_mutex_unlock(&mq_lock);
+	return settled;
+}
