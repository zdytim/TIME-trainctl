+/* The proof journal can be completed after the controller has restarted,
+ * including when the node's final RPC was lost. Freeze job and node state before selecting a proof; the settlement
+ * function then serializes against the WAL writer. */
+static void *recovery_loop(void *unused)
+{
+	struct pollfd wake = { .fd = recovery_wake[0], .events = POLLIN };
+	slurmctld_lock_t recovery_locks = {
+		.conf = READ_LOCK, .job = WRITE_LOCK, .node = WRITE_LOCK, .fed = READ_LOCK
+	};
+	assoc_mgr_lock_t tres_lock = { .tres = READ_LOCK };
+	(void) unused;
+	for (;;) {
+		monthly_quota_repair_t repaired;
+		int rc, repair;
+		lock_slurmctld(recovery_locks);
+		rc = monthly_quota_recovery_settle();
+		repair = rc < 0 ? -1 : monthly_quota_recovery_repair_one(&repaired);
+		unlock_slurmctld(recovery_locks);
+		if (rc < 0 || repair < 0) {
+			error("monthly quota recovery failed; admission remains closed");
+			break;
+		}
+		if (rc > 0)
+			info("monthly quota settled %d verified recovered allocation(s)", rc);
+		if (repair > 0) {
+			/* The job remains quarantined during the unlocked save. All
+			 * job snapshots are serialized, including their rename+fsync. */
+			if (dump_all_job_state() != SLURM_SUCCESS)
+				fatal("quota recovery job checkpoint failed; refusing scheduling");
+			lock_slurmctld(recovery_locks);
+			rc = monthly_quota_recovery_ack_saved(&repaired);
+			unlock_slurmctld(recovery_locks);
+			if (rc) break;
+			info("monthly quota restored and checkpointed JobId=%u", repaired.job_id);
+		}
+		/* Recheck every job and allocation before reopening admission.
+		 * Job write lock also prevents scheduling between reconciliation,
+		 * terminal-cancellation recovery and control socket startup. */
+		lock_slurmctld(recovery_locks);
+		assoc_mgr_lock(&tres_lock);
+		rc = monthly_quota_reconcile(job_list);
+		assoc_mgr_unlock(&tres_lock);
+		if (!rc && monthly_quota_reconcile_cancelled(job_list))
+			fatal("quota recovery cancellation reconciliation failed; refusing scheduling");
+		if (!rc && monthly_quota_control_start())
+			fatal("quota recovery control socket unavailable; refusing scheduling");
+		unlock_slurmctld(recovery_locks);
+		if (rc < 0) break;
+		if (!rc) {
+			info("monthly quota recovery complete; admission is available");
+			break;
+		}
+		do { rc = poll(&wake, 1, 1000); } while (rc < 0 && errno == EINTR);
+		if (rc != 0)
+			break;
+	}
+	return NULL;
+}
+
+int monthly_quota_recovery_worker_start(void)
+{
+	if (recovery_started || pipe2(recovery_wake, O_CLOEXEC))
+		return -1;
+	if (pthread_create(&recovery_thread, NULL, recovery_loop, NULL)) {
+		close(recovery_wake[0]); close(recovery_wake[1]);
+		recovery_wake[0] = recovery_wake[1] = -1;
+		return -1;
+	}
+	recovery_started = true;
 	return 0;
 }
 
+void monthly_quota_recovery_worker_stop(void)
+{
+	ssize_t sent;
+	if (!recovery_started)
+		return;
+	do { sent = write(recovery_wake[1], "x", 1); } while (sent < 0 && errno == EINTR);
+	if (sent != 1) { close(recovery_wake[1]); recovery_wake[1] = -1; }
+	pthread_join(recovery_thread, NULL);
+	close(recovery_wake[0]);
