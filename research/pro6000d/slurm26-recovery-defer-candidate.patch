+		if (!nodes || bit_size(nodes) != node_record_count) { ok = false; break; }
+		on_node = bit_test(nodes, node->index);
+		if (!on_node) continue;
+		if (IS_JOB_SUSPENDED(job) ||
+		    (IS_JOB_COMPLETING(job) &&
+		     (!monthly_quota_completion_is_deferred(job) || job->epilog_running))) { ok = false; break; }
