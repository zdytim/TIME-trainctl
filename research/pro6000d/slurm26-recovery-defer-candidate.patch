+/* Caller holds Slurm config/job/node locks. This read-only audit is also
+ * useful to verify a live allocation before invoking any recovery mutation. */
+int monthly_quota_selector_audit(struct job_record *job_ptr)
+{
+	mq_active_record_t *active;
+	uint64_t gpu = 0;
+	node_record_t *node;
+	int node_index = 0;
+	char marker[33];
+	enum time_tier tier;
+
+	if (!job_ptr || !job_ptr->node_bitmap || bit_set_count(job_ptr->node_bitmap) != 1)
+		return -1;
