+/* Call only after the serialized job checkpoint and directory fsync succeed. */
+int monthly_quota_recovery_ack_saved(const monthly_quota_repair_t *repair)
+{
+	mq_deferred_job_t **cursor, *item;
+	mq_reserve1_t *entry;
+	job_record_t *job;
+	int rc = -1;
+	if (!repair) return -1;
+	pthread_mutex_lock(&mq_lock);
+	job = find_job_record(repair->job_id);
+	for (entry = mq_reserves; entry; entry = entry->next)
+		if (entry->terminal == 2 && entry->uid == repair->uid &&
+		    entry->job_id == repair->job_id && entry->generation == repair->generation &&
+		    entry->final_sluid == repair->sluid) break;
+	if (!mq_healthy || !mq_recovery_pending || !entry || !job ||
+	    !IS_JOB_COMPLETED(job) || job->step_id.sluid != repair->sluid ||
+	    job->user_id != repair->uid || (job->job_state & JOB_STATE_BASE) != (repair->final_state & JOB_STATE_BASE) ||
+	    job->exit_code != repair->final_exit || job->derived_ec != repair->final_derived ||
+	    job->state_reason != repair->final_reason || job->requid != repair->final_requid ||
+	    !job->details || (uint64_t)job->details->submit_time != repair->submit_sec ||
+	    job->restart_cnt != repair->restart_count || (uint64_t)job->start_time != repair->start_sec ||
+	    (uint64_t)job->end_time != repair->end_sec)
