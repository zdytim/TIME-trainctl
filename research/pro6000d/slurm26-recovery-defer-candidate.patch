+		if (time_parse_job_marker(job->comment, marker, &tier) ||
+		    !(entry = _reserve1_find(job->user_id, marker)) || entry->terminal != 2 ||
+		    entry->job_id != job->job_id || entry->tier != tier || !entry->generation ||
+		    !entry->final_sluid || entry->final_sluid != job->step_id.sluid ||
+		    !job->details || job->details->submit_time <= 0 ||
+		    entry->final_submit != (uint64_t)job->details->submit_time ||
+		    entry->final_restart != job->restart_cnt || !entry->final_start ||
+		    entry->final_end < entry->final_start || !_field_safe(entry->final_node) ||
+		    !entry->gpu_bits[0] || strcmp(entry->gpu_conf, mq_gres_digest) ||
+		    strcmp(entry->gpu_inventory, mq_gpu_inventory_digest) ||
+		    strcmp(entry->gpu_node, entry->final_node) ||
+		    (IS_JOB_RUNNING(job) && !_gpu_map_matches(job, entry->gpu_node, entry->gpu_bits))) {
+			_mark_unhealthy("released recovery identity mismatch"); rc = -1; goto done_locked;
+		}
+		items[index] = (monthly_quota_repair_t) {
+			.job_id = entry->job_id, .uid = entry->uid, .sluid = entry->final_sluid,
+			.generation = entry->generation, .submit_sec = entry->final_submit,
+			.restart_count = entry->final_restart, .gpu_count = entry->gpu,
+			.start_sec = entry->final_start, .end_sec = entry->final_end,
+			.final_state = entry->final_state, .final_exit = entry->final_exit,
+			.final_derived = entry->final_derived, .final_reason = entry->final_reason,
+			.final_requid = entry->final_requid
+		};
+		memcpy(items[index].node, entry->final_node, sizeof(items[index].node));
+		memcpy(items[index].gpu_bits, entry->gpu_bits, sizeof(items[index].gpu_bits));
+		index++;
+	}
+done_locked:
+	pthread_mutex_unlock(&mq_lock);
+	if (rc < 0 || !items) { xfree(items); return rc; }
+	for (unsigned i = 0; i < index; i++) {
+		job = find_job_record(items[i].job_id);
+		rc = monthly_quota_restore_released(job, &items[i]);
+		if (rc) { if (rc > 0) *out = items[i]; break; }
+	}
+	xfree(items);
+	return rc;
