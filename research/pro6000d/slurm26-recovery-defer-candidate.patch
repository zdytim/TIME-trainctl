+/* The caller holds Slurm job/node write locks. Copy durable tombstones
+ * under mq_lock, then release mq_lock before invoking Slurm cleanup hooks. */
+int monthly_quota_recovery_repair_one(monthly_quota_repair_t *out)
+{
+	mq_deferred_job_t *deferred;
+	mq_reserve1_t *entry;
+	monthly_quota_repair_t *items = NULL;
+	job_record_t *job;
+	char marker[33];
+	enum time_tier tier;
+	unsigned count = 0, index = 0;
+	int rc = 0;
+	if (!out) return -1;
+	pthread_mutex_lock(&mq_lock);
+	if (!mq_healthy || !mq_recovery_pending || mq_reconciled) goto done_locked;
+	{
+		char conf[65], inventory[65];
+		if (_hash_gres_config(conf) || strcmp(conf, mq_gres_digest) ||
+		    _hash_gpu_inventory(inventory) || strcmp(inventory, mq_gpu_inventory_digest) || !_supported_gres_device_order()) {
+			_mark_unhealthy("device mapping changed before recovery repair"); rc = -1; goto done_locked;
+		}
+	}
+	for (deferred = mq_deferred_jobs; deferred; deferred = deferred->next)
+		if (++count > 4096) { _mark_unhealthy("too many recovery records"); rc = -1; goto done_locked; }
+	if (!count) goto done_locked;
+	items = xcalloc(count, sizeof(*items));
+	for (deferred = mq_deferred_jobs; deferred; deferred = deferred->next) {
+		job = find_job_record(deferred->job_id);
+		if (!job || job->step_id.sluid != deferred->sluid) {
+			_mark_unhealthy("quarantined job identity disappeared"); rc = -1; goto done_locked;
+		}
