+		char conf[65], inventory[65];
+		if (_hash_gres_config(conf) || strcmp(conf, mq_gres_digest) ||
+		    _hash_gpu_inventory(inventory) || strcmp(inventory, mq_gpu_inventory_digest) || !_supported_gres_device_order()) {
+			_mark_unhealthy("device mapping changed during recovery"); settled = -1; goto done;
+		}
+	}
+	for (;;) {
+		if (_find_node_proof(NULL) < 0) {
+			_mark_unhealthy("recovery node proof journal is invalid");
+			settled = -1;
+			goto done;
+		}
+		earliest = NULL;
+		for (active = mq_active; active; active = active->next) {
+			if (!active->committed) {
+				_mark_unhealthy("recovery found unresolved allocation intent");
+				settled = -1;
+				goto done;
+			}
+			if (!active->release_started)
+				continue;
