+typedef struct { unsigned minor; char uuid[41], bus[32]; } mq_gpu_device_t;
+static int _compare_gpu_device(const void *a, const void *b)
+{
+	const mq_gpu_device_t *left = a, *right = b;
+	return (left->minor > right->minor) - (left->minor < right->minor);
+}
+/* Proc information binds NVIDIA device minors to stable hardware UUIDs. */
+static int _hash_gpu_inventory(char hex[65])
+{
+	const char *root = "/proc/driver/nvidia/gpus";
+	char *pattern = NULL;
+	glob_t paths = {0};
+	mq_gpu_device_t devices[MQ_GPU_MAP_MAX];
+	unsigned count = 0;
+	unsigned char digest[SHA256_DIGEST_LENGTH];
+	static const char digits[] = "0123456789abcdef";
+	SHA256_CTX ctx;
+	int rc = -1;
+#if defined(TIME_ENABLE_MONTHLY_TEST_FIXTURE) && TIME_ENABLE_MONTHLY_TEST_FIXTURE
+	const char *fixture = getenv("TIME26_TEST_GPU_INFO_DIR");
+	if (fixture) {
+		char hostname[64];
+		if (gethostname(hostname, sizeof(hostname)) || strcmp(hostname, "colima") ||
+		    access("/dev/nvidiactl", F_OK) == 0 ||
+		    (strncmp(fixture, "/tmp/time26-gpu-probe-", strlen("/tmp/time26-gpu-probe-")) &&
+		     strncmp(fixture, "/tmp/time26-controller-probe-", strlen("/tmp/time26-controller-probe-")))) return -1;
+		root = fixture;
+		mq_test_inventory = true;
+	}
+#endif
+	pattern = xstrdup_printf("%s/*/information", root);
+	if (glob(pattern, 0, NULL, &paths) || !paths.gl_pathc || paths.gl_pathc > MQ_GPU_MAP_MAX)
+		goto done;
+	for (size_t i = 0; i < paths.gl_pathc; i++) {
+		char line[512], uuid[64] = "", bus[64] = "";
+		unsigned minor = UINT_MAX;
+		int fd = open(paths.gl_pathv[i], O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+		FILE *stream;
+		if (fd < 0) goto done;
+		stream = fdopen(fd, "r");
+		if (!stream) { close(fd); goto done; }
+		while (fgets(line, sizeof(line), stream)) {
+			(void) sscanf(line, "GPU UUID: %63s", uuid);
+			(void) sscanf(line, "Bus Location: %63s", bus);
+			(void) sscanf(line, "Device Minor: %u", &minor);
+		}
+		if (ferror(stream)) { fclose(stream); goto done; }
+		if (fclose(stream)) goto done;
+		if (strlen(uuid) != 40 || strncmp(uuid, "GPU-", 4) ||
+		    strspn(uuid + 4, "0123456789abcdefABCDEF-") != 36 ||
+		    !bus[0] || strlen(bus) >= sizeof(devices[0].bus) ||
+		    strspn(bus, "0123456789abcdefABCDEF:.") != strlen(bus) ||
+		    minor >= MQ_GPU_MAP_MAX) goto done;
+		for (unsigned j = 0; j < count; j++)
+			if (devices[j].minor == minor || !strcmp(devices[j].uuid, uuid) || !strcmp(devices[j].bus, bus)) goto done;
+		devices[count].minor = minor;
+		memcpy(devices[count].uuid, uuid, 41);
+		memcpy(devices[count].bus, bus, strlen(bus) + 1);
+		count++;
+	}
+	qsort(devices, count, sizeof(devices[0]), _compare_gpu_device);
+	for (unsigned i = 0; i < count; i++) {
+		char device_path[64];
+		struct stat st;
+		/* The supported File=/dev/nvidia[0-N] mapping is contiguous. */
+		if (devices[i].minor != i) goto done;
+		if (!mq_test_inventory) {
+			if (snprintf(device_path, sizeof(device_path), "/dev/nvidia%u", i) >= sizeof(device_path) ||
+			    lstat(device_path, &st) || !S_ISCHR(st.st_mode) || st.st_uid != 0 ||
+			    major(st.st_rdev) != 195 || minor(st.st_rdev) != i) goto done;
+		}
+	}
+	mq_gpu_inventory_count = count;
+	if (SHA256_Init(&ctx) != 1) goto done;
+	for (unsigned i = 0; i < count; i++) {
+		char item[128];
+		int len = snprintf(item, sizeof(item), "%u|%s|%s\n", devices[i].minor, devices[i].uuid, devices[i].bus);
+		if (len <= 0 || (size_t)len >= sizeof(item) || SHA256_Update(&ctx, item, len) != 1) goto done;
+	}
+	if (SHA256_Final(digest, &ctx) != 1) goto done;
+	for (int i = 0; i < SHA256_DIGEST_LENGTH; i++) {
+		hex[2*i] = digits[digest[i] >> 4]; hex[2*i+1] = digits[digest[i] & 15];
+	}
+	hex[64] = '\0'; rc = 0;
+done:
+	xfree(pattern); globfree(&paths); return rc;
 }
 
+/* For this single-node release, only a deterministic, contiguous File
+ * mapping is supported. Arbitrary paths/symlinks cannot be tied to UUIDs. */
+static bool _supported_gres_device_order(void)
+{
+	char expected[80], *path, line[8192];
+	FILE *stream;
+	unsigned gpu_lines = 0, autodetect_lines = 0;
+	bool ok = true;
+	node_record_t *local, *other;
+	int index = 0;
+	char hostname[256];
+	if (mq_test_inventory) return true;
+	local = next_node(&index); other = next_node(&index);
+	if (!local || other || !local->node_hostname || gethostname(hostname, sizeof(hostname))) return false;
+	hostname[sizeof(hostname) - 1] = '\0';
+	if (strcmp(local->node_hostname, hostname)) return false;
+	if (!mq_gpu_inventory_count || mq_gpu_inventory_count > MQ_GPU_MAP_MAX) return false;
+	if (mq_gpu_inventory_count == 1)
+		snprintf(expected, sizeof(expected), "/dev/nvidia0");
+	else
+		snprintf(expected, sizeof(expected), "/dev/nvidia[0-%u]", mq_gpu_inventory_count - 1);
+	path = get_extra_conf_path("gres.conf");
+	if (!path) return false;
+	stream = fopen(path, "r"); xfree(path);
+	if (!stream) return false;
+	while (fgets(line, sizeof(line), stream)) {
+		char *save = NULL, *token, *hash = strchr(line, '#');
+		bool gpu = false;
+		const char *file = NULL, *node_name = NULL;
+		if (!strchr(line, '\n') && !feof(stream)) { ok = false; break; }
+		if (hash) *hash = '\0';
+		for (token = strtok_r(line, " \t\r\n", &save); token;
+		     token = strtok_r(NULL, " \t\r\n", &save)) {
+			if (!strcasecmp(token, "Name=gpu")) gpu = true;
+			if (!strncasecmp(token, "NodeName=", 9)) {
+				if (node_name) { ok = false; break; }
+				node_name = token + 9;
+			}
+			if (!strncasecmp(token, "AutoDetect=", 11)) {
+				if (++autodetect_lines != 1 ||
+				    (strcasecmp(token + 11, "nvml") && strcasecmp(token + 11, "off"))) { ok = false; break; }
+			}
+			if (!strncasecmp(token, "File=", 5)) {
+				if (file) { ok = false; break; }
+				file = token + 5;
+			}
+		}
+		if (!ok) break;
+		if (gpu && (++gpu_lines != 1 || !file || strcmp(file, expected) ||
+		    (node_name && strcmp(node_name, local->name)))) { ok = false; break; }
+	}
+	if (ferror(stream)) ok = false;
+	if (fclose(stream)) ok = false;
+	return ok && gpu_lines == 1;
+}
