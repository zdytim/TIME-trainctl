+/* Publish only after the in-process GRES mapping has been checked.  The
+ * root controller wrapper binds its pidfd to this exact boot/process. */
+static int _quota_write_node_ready(void)
+{
+	const char *path = getenv("TIME_QUOTA_NODE_READY_FILE");
+	char boot[64], statline[4096], *cursor, *field, *save;
+	char data[256], temporary[96] = "", *parent, *slash;
+	FILE *stream;
+	struct stat dir;
+	unsigned long long ticks = 0;
+	int dfd = -1, fd = -1, rc = -1, len;
+	if (!path) return -1;
+#if defined(TIME_ENABLE_MONTHLY_TEST_FIXTURE) && TIME_ENABLE_MONTHLY_TEST_FIXTURE
+	if (strncmp(path, "/tmp/time26-gpu-probe-", strlen("/tmp/time26-gpu-probe-")))
+#endif
+	if (strcmp(path, "/var/lib/pro6000d-monthly/node-ready")) return -1;
+	stream = fopen("/proc/sys/kernel/random/boot_id", "r");
+	if (!stream) return -1;
+	if (!fgets(boot, sizeof(boot), stream)) { fclose(stream); return -1; }
+	fclose(stream); boot[strcspn(boot, "\r\n")] = '\0';
+	if (strlen(boot) != 36 || strspn(boot, "0123456789abcdef-") != 36) return -1;
+	stream = fopen("/proc/self/stat", "r");
+	if (!stream) return -1;
+	if (!fgets(statline, sizeof(statline), stream)) { fclose(stream); return -1; }
+	fclose(stream);
+	cursor = strrchr(statline, ')');
+	if (!cursor) return -1;
+	cursor++;
+	field = strtok_r(cursor, " ", &save);
+	for (int i = 0; i < 19 && field; i++) field = strtok_r(NULL, " ", &save);
+	if (!field || sscanf(field, "%llu", &ticks) != 1 || !ticks) return -1;
+	len = snprintf(data, sizeof(data), "P6NR1|%ld|%llu|%s\n", (long)getpid(), ticks, boot);
+	if (len <= 0 || (size_t)len >= sizeof(data)) return -1;
+	parent = xstrdup(path); slash = strrchr(parent, '/');
+	if (!slash || slash == parent) goto done;
+	*slash = '\0';
+	dfd = open(parent, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (dfd < 0 || fstat(dfd, &dir) || !S_ISDIR(dir.st_mode) || dir.st_uid != 0 || (dir.st_mode & 0077)) goto done;
+	snprintf(temporary, sizeof(temporary), ".node-ready-%ld.tmp", (long)getpid());
+	fd = openat(dfd, temporary, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+	if (fd < 0 || write(fd, data, len) != len || fsync(fd)) goto done;
+	if (close(fd)) { fd = -1; goto done; }
+	fd = -1;
+	if (renameat(dfd, temporary, dfd, "node-ready") || fsync(dfd)) goto done;
+	rc = 0;
+done:
+	if (fd >= 0) close(fd);
+	if (dfd >= 0) { if (rc && temporary[0]) unlinkat(dfd, temporary, 0); close(dfd); }
+	xfree(parent);
+	return rc;
 }
 
+/* Verify Slurm's parsed bitmap-index-to-device mapping, including NVML
+ * merges, before this node can register for monthly quota scheduling. */
+static bool _quota_node_devices_valid(void)
+{
+	list_t *devices = gres_g_get_devices(NULL, false, 0, NULL, 0, NULL);
+	list_itr_t *it;
+	gres_device_t *device;
+	bool seen[128] = {0}, valid = true, fixture = false;
+	unsigned count = 0;
+#if defined(TIME_ENABLE_MONTHLY_TEST_FIXTURE) && TIME_ENABLE_MONTHLY_TEST_FIXTURE
+	const char *path = getenv("TIME26_TEST_GPU_INFO_DIR");
+	char hostname[64];
+	if (path && !gethostname(hostname, sizeof(hostname)) && !strcmp(hostname, "colima") &&
+	    access("/dev/nvidiactl", F_OK) != 0 &&
+	    !strncmp(path, "/tmp/time26-gpu-probe-", strlen("/tmp/time26-gpu-probe-"))) fixture = true;
+#endif
+	if (!devices) return false;
+	it = list_iterator_create(devices);
+	while ((device = list_next(it))) {
+		char expected[64];
+		struct stat st;
+		int index = device->index;
+		if (index < 0 || index >= 128 || !device->path || seen[index]) { valid = false; break; }
+		if (fixture) {
+			if (index > 1) { valid = false; break; }
+			snprintf(expected, sizeof(expected), "%s", index ? "/dev/zero" : "/dev/null");
+		} else
+			snprintf(expected, sizeof(expected), "/dev/nvidia%d", index);
+		if (strcmp(device->path, expected) || lstat(expected, &st) || !S_ISCHR(st.st_mode) ||
+		    st.st_uid != 0 || device->dev_desc.type != DEV_TYPE_CHAR ||
+		    device->dev_desc.major != major(st.st_rdev) || device->dev_desc.minor != minor(st.st_rdev) ||
+		    (!fixture && (major(st.st_rdev) != 195 || minor(st.st_rdev) != (unsigned)index))) {
+			valid = false; break;
+		}
+		seen[index] = true; count++;
+	}
+	list_iterator_destroy(it);
+	FREE_NULL_LIST(devices);
+	if (!count) return false;
+	for (unsigned i = 0; i < count; i++) if (!seen[i]) valid = false;
+	if (!fixture) {
+		for (unsigned i = 0; i < 128; i++) {
+			char path[64]; struct stat st;
+			snprintf(path, sizeof(path), "/dev/nvidia%u", i);
+			if (!lstat(path, &st) && !seen[i]) valid = false;
+		}
+	}
+	return valid;
+}
