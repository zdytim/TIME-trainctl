+	    prior->uid != intent->uid || prepared->uid != intent->uid || marker->uid != intent->uid ||
+	    prior->job_id != intent->job_id || prepared->job_id != intent->job_id || marker->job_id != intent->job_id ||
+	    prior->generation != intent->old_generation || marker->generation != intent->old_generation ||
+	    prior->final_submit != intent->old_submit || prior->final_sluid != intent->old_sluid ||
+	    prior->final_restart != intent->old_restart || marker->submit != intent->old_submit ||
+	    marker->sluid != intent->old_sluid || marker->restart != intent->old_restart ||
+	    !intent->old_submit || !intent->old_sluid || !intent->next_submit || !intent->next_sluid ||
+	    prepared->submit_sec != intent->next_submit || prepared->sluid != intent->next_sluid ||
+	    prepared->restart_count != intent->next_restart || marker->next_submit != intent->next_submit ||
+	    marker->next_sluid != intent->next_sluid || marker->next_restart != intent->next_restart ||
+	    !marker->requeue_pending || !marker->requeue_verified ||
+	    prepared->reservation_key.requeue.restart != intent->next_restart ||
+	    strcmp(prepared->marker_id, intent->marker) || strcmp(prior->request, intent->marker) ||
+	    strcmp(marker->marker, intent->marker) ||
