+static bool _reservation_time_matches(const mq_reserve1_t *entry, uint32_t time_limit)
+{
+	if (!entry || !time_limit) return false;
+	if (entry->policy_version == 2)
+		return entry->minutes == INFINITE && time_limit == INFINITE;
+	if (entry->policy_version > 2) return false;
+	return entry->minutes == time_limit;
+}
