+		mq_requeue_intent_t *intent = NULL;
+		mq_top_marker_t *marker;
+		if (!prior) return -1;
+		if (prior->policy_version != 2) continue; /* Preserve legacy replay. */
+		marker = _top_marker_find(prepared->marker_id);
+		if (mq_requeue_find(mq_requeue_intents, &prepared->reservation_key.requeue, &intent) != 1 ||
+		    !_v2_requeue_postproof_valid(prepared, intent, prior, marker)) return -1;
+	}
+	return 0;
+}
