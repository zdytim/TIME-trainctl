+/* Caller holds Slurm job locks.  Look up immutable v2 binding rather than
+ * trusting the mutable job comment, requeue flag or time limit. */
+bool monthly_quota_requeue_prohibited(const struct job_record *job)
+{
+	const mq_reserve1_t *entry;
+	char marker[33]; enum time_tier tier;
+	bool blocked = false;
+	if (!job) return true;
+	pthread_mutex_lock(&mq_lock);
+	if (!mq_enabled && !_token_enabled()) goto done;
+	/* Prefer a matching persisted binding even when the ledger is unhealthy. */
+	for (entry = mq_reserves; entry; entry = entry->next) {
+		bool same_instance;
+		if (!entry->job_id || entry->job_id != job->job_id) continue;
+		same_instance = entry->uid == job->user_id && job->details &&
+			entry->bind_submit && entry->bind_sluid &&
+			entry->bind_submit == (uint64_t)job->details->submit_time &&
+			entry->bind_sluid == (uint64_t)job->step_id.sluid;
+		if (same_instance) { blocked = entry->policy_version > 1; goto done; }
+		if (entry->policy_version > 1 && !entry->terminal) {
+			blocked = true; goto done;
+		}
+	}
+	/* A managed job lacking a binding is uncertain if its ledger is not
+	 * ready; finite legacy reservations are not inferred from mutable time. */
+	if (!time_parse_job_marker(job->comment, marker, &tier) &&
+	    (!mq_enabled || !mq_healthy || !mq_reconciled || !mq_selectable_replay ||
+	     job->time_limit == INFINITE)) blocked = true;
+done:
+	pthread_mutex_unlock(&mq_lock);
+	return blocked;
+}
