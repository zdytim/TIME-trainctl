+int monthly_quota_cancel_bound2(uid_t uid, const char *request, uint32_t job_id,
+		uint64_t submit, uint64_t sluid)
+{
+	mq_reserve1_t *entry;
+	struct job_record *job;
+	enum time_tier tier;
+	char marker[33];
+	int rc = -1;
+	if ((uid_t)(uint32_t)uid != uid || !_reserve1_request_valid(request) ||
+	    !job_id || !submit || !sluid || !monthly_top_job_write_locked()) return -1;
+	pthread_mutex_lock(&mq_lock);
+	entry = _reserve1_find(uid, request);
+	if (!mq_enabled || !mq_healthy || !mq_reconciled || !mq_selectable_replay || !entry ||
+	    entry->policy_version != 2 || entry->job_id != job_id || entry->bind_submit != submit ||
+	    entry->bind_sluid != sluid || _find_active_job(job_id)) goto out;
+	if (entry->terminal == 3 && !entry->generation) { rc = 0; goto out; }
+	if (entry->terminal == 2 && entry->generation && entry->final_node_proven &&
+	    entry->final_submit == submit && entry->final_sluid == sluid) { rc = 0; goto out; }
+	if (entry->terminal || entry->generation || !(job = find_job_record(job_id)) ||
+	    job->user_id != uid || !IS_JOB_COMPLETED(job) || IS_JOB_COMPLETING(job) ||
+	    !job->details || job->details->submit_time <= 0 ||
+	    (uint64_t)job->details->submit_time != submit || job->step_id.sluid != sluid || job->restart_cnt ||
+	    (job->start_time && (!job->end_time || job->start_time != job->end_time)) ||
+	    job->node_cnt || (job->node_bitmap && bit_set_count(job->node_bitmap)) ||
+	    time_parse_job_marker(job->comment, marker, &tier) || strcmp(marker, request) || tier != entry->tier) goto out;
+	if (_append_event("CANCEL_BOUND2|%u|%s|%u|%" PRIu64 "|%" PRIu64,
+			  (uint32_t)uid, request, job_id, submit, sluid)) {
+		_mark_unhealthy("bound cancellation persistence failed"); goto out;
+	}
+	_reserve1_finish(entry, 3, 0);
+	rc = 0;
+out:
+	pthread_mutex_unlock(&mq_lock);
+	return rc;
+}
