+/* Called under the same Slurm locks as job cancellation, before the first
+ * scheduling pass. Reconcile independently persisted job and quota states. */
+int monthly_quota_reconcile_cancelled(list_t *jobs)
+{
+	list_itr_t *iterator;
+	struct job_record *job;
+	int result = 0;
+	if (!jobs) return -1;
+	iterator = list_iterator_create(jobs);
+	while ((job = list_next(iterator))) {
+		mq_reserve1_t *entry;
+		char marker[33];
+		enum time_tier selected;
+		int action = 0;
+		if (time_parse_job_marker(job->comment, marker, &selected)) continue;
+		pthread_mutex_lock(&mq_lock);
+		entry = _reserve1_find(job->user_id, marker);
+		if (mq_enabled && mq_healthy && mq_reconciled && entry && entry->tier == selected &&
+		    (!entry->job_id || entry->job_id == job->job_id) && !entry->generation) {
+			if (entry->terminal == 3 && entry->job_id == job->job_id && IS_JOB_PENDING(job))
+				action = 1; /* cancelled WAL, stale pending Slurm checkpoint */
+			else if (!entry->terminal && IS_JOB_COMPLETED(job))
+				action = 2; /* terminal Slurm job before ledger recovery */
+		}
+		pthread_mutex_unlock(&mq_lock);
+		if (action == 1) {
+			if (IS_JOB_COMPLETING(job) || job->het_job_id || job->array_recs || job->fed_details ||
+			    (job->node_bitmap && bit_set_count(job->node_bitmap)) ||
+			    job_signal(job, SIGKILL, KILL_NO_SIBS, slurm_conf.slurm_user_id, false) != SLURM_SUCCESS) {
+				result = -1; break;
+			}
+		} else if (action == 2 && monthly_quota_cancel_bound1(job->user_id, marker, job->job_id)) {
+			result = -1; break;
+		}
+	}
+	list_iterator_destroy(iterator);
+	if (result) {
+		pthread_mutex_lock(&mq_lock);
+		_mark_unhealthy("cancelled job recovery is ambiguous");
+		pthread_mutex_unlock(&mq_lock);
+	}
+	return result;
+}
