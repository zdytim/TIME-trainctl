+#if defined(TIME_ENABLE_MONTHLY_QUERY2_DRAFT) && TIME_ENABLE_MONTHLY_QUERY2_DRAFT
+	} else if (count == 3 && !strcmp(part[0], "RESERVE2_GET")) {
+		int status;
