+#if defined(TIME_ENABLE_MONTHLY_QUERY2_DRAFT) && TIME_ENABLE_MONTHLY_QUERY2_DRAFT
+typedef struct {
+	uint32_t month, tier, gpu, minutes, job_id, state;
+	uint64_t amount, generation, sluid;
+} monthly_reservation_status_t;
+/* Return 1 if found, 0 if absent now, -1 if state is unavailable. Absence
+ * does not prove that a previous request never took effect. */
+extern int monthly_quota_reservation_status(uid_t uid, const char *request,
+					    monthly_reservation_status_t *out);
+#endif
