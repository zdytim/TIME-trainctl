+#ifndef MONTHLY_TOP_MARKERS_H
+#define MONTHLY_TOP_MARKERS_H
+
+typedef struct mq_top_marker {
+	uint32_t uid;
+	uint32_t job_id, restart;
+	uint64_t submit, sluid;
+	uint64_t generation;
+	bool pending;
+	bool started;
+	bool acknowledged;
+	bool requeue_guarded;
+	bool requeue_pending;
+	bool requeue_verified;
+	uint64_t next_submit, next_sluid;
+	uint32_t next_restart;
+	char marker[33];
+	struct mq_top_marker *next;
+} mq_top_marker_t;
+
+static mq_top_marker_t *mq_top_markers;
+
+typedef struct mq_top_marker_v2 {
+	uint32_t uid;
+	bool cancelled;
+	bool bound, started, acknowledged;
+	bool explicit_hold, cancel_requested;
+	uint32_t job_id, restart;
+	uint64_t submit, sluid, generation;
+	char marker[33], account_generation[33];
+	bool identity_complete;
+	char request_id[81], request_hash[65];
+	struct mq_top_marker_v2 *next;
+} mq_top_marker_v2_t;
+static mq_top_marker_v2_t *mq_top_markers_v2;
+/* Reconstructed from the first ADD3 event during WAL replay. */
+static bool mq_top_add3_sealed;
+
+static mq_top_marker_t *_top_marker_find(const char *marker)
+{
+	mq_top_marker_t *entry;
+	for (entry = mq_top_markers; entry; entry = entry->next)
+		if (!strcmp(entry->marker, marker)) return entry;
+	return NULL;
+}
+
+static int _top_marker_ack(mq_top_marker_t *entry, uint32_t uid, uint32_t job_id,
+		uint64_t submit, uint64_t sluid, uint32_t restart, uint64_t generation)
+{
+	if (!entry || !entry->started || entry->pending || entry->uid != uid ||
+	    entry->job_id != job_id || entry->submit != submit || entry->sluid != sluid ||
+	    entry->restart != restart || !generation || entry->generation != generation)
+		return -1;
+	entry->acknowledged = true;
+	return 0;
+}
+
+static int _top_marker_requeue_check(mq_top_marker_t *entry, uint32_t uid,
+		uint32_t job_id, uint64_t submit, uint64_t sluid, uint32_t restart,
+		uint64_t generation, uint64_t next_submit, uint64_t next_sluid,
+		uint32_t next_restart)
+{
+	if (!entry || !entry->started || entry->pending ||
+	    entry->uid != uid || !job_id || entry->job_id != job_id ||
+	    !submit || entry->submit != submit || !sluid || entry->sluid != sluid ||
+	    entry->restart != restart || !generation || entry->generation != generation ||
+	    restart >= UINT16_MAX || next_restart != restart + 1 || !next_submit || !next_sluid)
+		return -1;
+	if (entry->requeue_pending && (entry->next_submit != next_submit ||
+	    entry->next_sluid != next_sluid || entry->next_restart != next_restart)) return -1;
+	return 0;
+}
+
+static void _top_marker_requeue_apply(mq_top_marker_t *entry, uint64_t submit,
+		uint64_t sluid, uint32_t restart)
+{
+	entry->next_submit = submit;
+	entry->next_sluid = sluid;
+	entry->next_restart = restart;
+	entry->requeue_pending = true;
+}
+
+static int _top_marker_apply(uint32_t uid, const char *marker, bool add)
+{
+	mq_top_marker_t *entry = _top_marker_find(marker);
+	if (entry) {
+		if (entry->uid != uid || (add && !entry->pending) ||
+		    (!add && entry->started)) return -1;
+		if (!add) entry->pending = false;
+		return 0;
+	}
+	if (!add) return -1;
+	entry = xcalloc(1, sizeof(*entry));
+	entry->uid = uid;
+	entry->pending = true;
+	memcpy(entry->marker, marker, sizeof(entry->marker));
+	entry->next = mq_top_markers;
+	mq_top_markers = entry;
+	return 0;
+}
+
+static int _top_marker_start_check(const mq_top_marker_t *entry, uint32_t uid,
+		uint32_t job_id, uint64_t submit, uint64_t sluid, uint32_t restart,
+		uint64_t generation)
+{
+	if (!entry || !entry->pending || entry->started || entry->uid != uid ||
+	    !job_id || entry->job_id != job_id || !submit || entry->submit != submit ||
+	    !sluid || entry->sluid != sluid || entry->restart != restart || !generation)
+		return -1;
+	return 0;
+}
+
+static int _top_marker_start(mq_top_marker_t *entry, uint32_t uid,
+		uint32_t job_id, uint64_t submit, uint64_t sluid, uint32_t restart,
+		uint64_t generation)
+{
+	if (_top_marker_start_check(entry, uid, job_id, submit, sluid, restart, generation))
+		return -1;
+	entry->generation = generation;
+	entry->pending = false;
+	entry->started = true;
+	return 0;
+}
+
+static int _top_marker_bind(uint32_t uid, const char *marker, uint32_t job_id,
+			    uint64_t submit, uint64_t sluid, uint32_t restart)
+{
+	mq_top_marker_t *entry = _top_marker_find(marker);
+	if (!entry || !entry->pending || entry->uid != uid || !job_id ||
+	    !submit || !sluid) return -1;
+	if (entry->job_id)
+		return entry->job_id == job_id && entry->submit == submit &&
+			entry->sluid == sluid && entry->restart == restart ? 0 : -1;
+	entry->job_id = job_id;
+	entry->submit = submit;
+	entry->sluid = sluid;
+	entry->restart = restart;
+	return 0;
+}
+#endif
