+		unsigned char digest[SHA256_DIGEST_LENGTH])
+{
+	SHA256_CTX context;
+	unsigned char row_digest[SHA256_DIGEST_LENGTH], node_digest[SHA256_DIGEST_LENGTH];
+	uint64_t submit, sluid;
+	if (!target || !digest || !generation || !target->job_id || target->job_id == NO_VAL ||
+	    target->user_id == NO_VAL || !target->details || target->details->submit_time <= 0 ||
