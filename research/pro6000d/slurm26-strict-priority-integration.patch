+		    SHA256_Update(&context, identity64, sizeof(identity64)) != 1 ||
+		    SHA256_Update(&context, &resources->whole_node, sizeof(resources->whole_node)) != 1 ||
+		    SHA256_Update(&context, &length, sizeof(length)) != 1) return SLURM_ERROR;
+		for (uint64_t bit = 0; bit < length; bit++) {
+			unsigned char value = bit_test(resources->core_bitmap, bit) ? 1 : 0;
+			if (SHA256_Update(&context, &value, sizeof(value)) != 1) return SLURM_ERROR;
+		}
+		length = bit_size(resources->node_bitmap);
+		if (SHA256_Update(&context, &length, sizeof(length)) != 1) return SLURM_ERROR;
+		for (uint64_t bit = 0; bit < length; bit++) {
+			unsigned char value = bit_test(resources->node_bitmap, bit) ? 1 : 0;
+			if (SHA256_Update(&context, &value, sizeof(value)) != 1) return SLURM_ERROR;
+		}
