+#ifndef MONTHLY_TOP_IDENTITY_H
+#define MONTHLY_TOP_IDENTITY_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+static bool _top_hex(const char *value, size_t length)
+{
+	if (!value || strlen(value) != length)
+		return false;
+	for (size_t index = 0; index < length; index++)
+		if (!((value[index] >= '0' && value[index] <= '9') ||
+		      (value[index] >= 'a' && value[index] <= 'f')))
+			return false;
+	return true;
+}
+
+static bool _add3_valid(const char *marker, const char *account,
+			const char *request, const char *hash)
+{
+	size_t length;
+	if (!_top_hex(marker, 32) || !_top_hex(account, 32) ||
+	    !_top_hex(hash, 64) || !request)
+		return false;
+	length = strlen(request);
+	if (length < 8 || length > 80)
+		return false;
+	for (size_t index = 0; index < length; index++) {
+		unsigned char character = request[index];
+		if (!((character >= 'a' && character <= 'z') ||
+		      (character >= 'A' && character <= 'Z') ||
+		      (character >= '0' && character <= '9') || character == '-'))
+			return false;
+	}
+	return true;
+}
+
+static int _top_identity_relation(uint32_t left_uid, const char *left_marker,
+		const char *left_account, const char *left_request, const char *left_hash,
+		uint32_t right_uid, const char *right_marker, const char *right_account,
+		const char *right_request, const char *right_hash)
+{
+	if (strcmp(left_marker, right_marker) &&
+	    (left_uid != right_uid || strcmp(left_request, right_request)))
+		return 0;
+	if (left_uid != right_uid || strcmp(left_marker, right_marker) ||
+	    strcmp(left_account, right_account) || strcmp(left_request, right_request) ||
+	    strcmp(left_hash, right_hash))
+		return -1;
+	return 1;
+}
+
+#endif
