+extern int select_p_quota_partial_node_hash(int node, unsigned char digest[SHA256_DIGEST_LENGTH])
+{
+	SHA256_CTX context;
+	node_use_record_t *usage;
+	quota_node_job_identity_t *jobs = NULL;
+	list_itr_t *iterator = NULL, *check;
+	job_record_t *job, *other;
+	uint64_t length, count, index = 0, memory = 0, state = 0;
+	int rc = SLURM_ERROR;
+	if (!digest || node < 0 || node >= node_record_count || !select_node_usage ||
+	    !node_record_table_ptr || !node_record_table_ptr[node] ||
+	    !node_record_table_ptr[node]->name || !job_list) return SLURM_ERROR;
+	usage = &select_node_usage[node];
+	if (usage->gres_list || node_record_table_ptr[node]->gres_list ||
+	    (usage->jobs && list_count(usage->jobs) > 4096)) return SLURM_ERROR;
+	count = usage->jobs ? list_count(usage->jobs) : 0;
+	jobs = xcalloc(count ? count : 1, sizeof(*jobs));
+	if (usage->jobs) iterator = list_iterator_create(usage->jobs);
+	while (iterator && (job = list_next(iterator))) {
+		unsigned matches = 0;
+		uint32_t offset = 0;
+		if (index >= count || !job->job_id || job->job_id == NO_VAL ||
+		    job->user_id == NO_VAL || !job->details || job->details->submit_time <= 0 ||
+		    !job->step_id.sluid || job->restart_cnt == NO_VAL16 ||
+		    !job->job_resrcs || !job->job_resrcs->node_bitmap ||
+		    bit_size(job->job_resrcs->node_bitmap) != node_record_count ||
+		    !bit_test(job->job_resrcs->node_bitmap, node) ||
+		    (!IS_JOB_RUNNING(job) && !IS_JOB_SUSPENDED(job))) goto out;
+		check = list_iterator_create(job_list);
+		while ((other = list_next(check))) if (other == job) matches++;
+		list_iterator_destroy(check);
+		if (matches != 1) goto out;
+		for (int previous = 0; previous < node; previous++)
+			if (bit_test(job->job_resrcs->node_bitmap, previous)) offset++;
+		if (offset >= job->job_resrcs->nhosts || !job->job_resrcs->memory_allocated ||
+		    UINT64_MAX - memory < job->job_resrcs->memory_allocated[offset] ||
+		    UINT64_MAX - state < job->job_resrcs->node_req) goto out;
+		memory += job->job_resrcs->memory_allocated[offset];
+		state += job->job_resrcs->node_req;
+		jobs[index].uid = job->user_id; jobs[index].job_id = job->job_id;
+		jobs[index].restart = job->restart_cnt; jobs[index].sluid = job->step_id.sluid;
+		jobs[index].memory = job->job_resrcs->memory_allocated[offset];
+		jobs[index].node_req = job->job_resrcs->node_req;
+		jobs[index].submit = job->details->submit_time; index++;
+	}
+	if (index != count || memory != usage->alloc_memory || state != usage->node_state) goto out;
+	check = list_iterator_create(job_list);
+	while ((job = list_next(check))) {
+		unsigned matches = 0;
+		list_itr_t *members;
+		if (!IS_JOB_RUNNING(job) && !IS_JOB_SUSPENDED(job)) continue;
+		if (!job->job_resrcs || !job->job_resrcs->node_bitmap ||
+		    bit_size(job->job_resrcs->node_bitmap) != node_record_count) {
+			list_iterator_destroy(check); goto out;
+		}
+		if (!bit_test(job->job_resrcs->node_bitmap, node)) continue;
+		if (!usage->jobs) { list_iterator_destroy(check); goto out; }
+		members = list_iterator_create(usage->jobs);
+		while ((other = list_next(members))) if (other == job) matches++;
+		list_iterator_destroy(members);
+		if (matches != 1) { list_iterator_destroy(check); goto out; }
+	}
+	list_iterator_destroy(check);
+	qsort(jobs, count, sizeof(*jobs), _quota_node_job_compare);
+	for (index = 1; index < count; index++)
+		if (jobs[index - 1].job_id == jobs[index].job_id) goto out;
+	length = strlen(node_record_table_ptr[node]->name);
+	if (!length || SHA256_Init(&context) != 1 ||
+	    SHA256_Update(&context, &node, sizeof(node)) != 1 ||
+	    SHA256_Update(&context, &length, sizeof(length)) != 1 ||
+	    SHA256_Update(&context, node_record_table_ptr[node]->name, length) != 1 ||
+	    SHA256_Update(&context, &usage->alloc_memory, sizeof(usage->alloc_memory)) != 1 ||
+	    SHA256_Update(&context, &usage->node_state, sizeof(usage->node_state)) != 1 ||
+	    SHA256_Update(&context, &count, sizeof(count)) != 1) goto out;
+	for (index = 0; index < count; index++)
+		if (SHA256_Update(&context, &jobs[index].uid, sizeof(jobs[index].uid)) != 1 ||
+		    SHA256_Update(&context, &jobs[index].job_id, sizeof(jobs[index].job_id)) != 1 ||
+		    SHA256_Update(&context, &jobs[index].restart, sizeof(jobs[index].restart)) != 1 ||
+		    SHA256_Update(&context, &jobs[index].sluid, sizeof(jobs[index].sluid)) != 1 ||
+		    SHA256_Update(&context, &jobs[index].submit, sizeof(jobs[index].submit)) != 1 ||
+		    SHA256_Update(&context, &jobs[index].memory, sizeof(jobs[index].memory)) != 1 ||
+		    SHA256_Update(&context, &jobs[index].node_req, sizeof(jobs[index].node_req)) != 1) goto out;
+	if (SHA256_Final(digest, &context) == 1) rc = SLURM_SUCCESS;
+out:
+	if (iterator) list_iterator_destroy(iterator);
+	xfree(jobs);
+	return rc;
+}
