+extern int select_p_quota_partial_row_hash(part_res_record_t *part,
+		part_row_data_t *row, unsigned char digest[SHA256_DIGEST_LENGTH])
+{
+	SHA256_CTX context;
+	list_itr_t *iterator;
+	job_record_t *job, *owner;
+	uint64_t count, length;
+	unsigned matches, row_index;
+	if (!part || !part->part_ptr || !part->part_ptr->name || !part->row || !row ||
+	    !digest || !job_list || node_record_count < 0 ||
+	    !_quota_row_consistent(part, row) ||
+	    SHA256_Init(&context) != 1) return SLURM_ERROR;
