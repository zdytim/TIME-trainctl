+static int _quota_node_job_compare(const void *left, const void *right)
+{
+	const quota_node_job_identity_t *first = left, *second = right;
+	if (first->job_id != second->job_id) return first->job_id < second->job_id ? -1 : 1;
+	return 0;
+}
