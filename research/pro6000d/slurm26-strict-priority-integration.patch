+	    SHA256_Update(&context, &target->user_id, sizeof(target->user_id)) != 1 ||
+	    SHA256_Update(&context, &target->job_id, sizeof(target->job_id)) != 1 ||
+	    SHA256_Update(&context, &submit, sizeof(submit)) != 1 ||
+	    SHA256_Update(&context, &sluid, sizeof(sluid)) != 1 ||
+	    SHA256_Update(&context, &target->restart_cnt, sizeof(target->restart_cnt)) != 1 ||
+	    SHA256_Update(&context, &generation, sizeof(generation)) != 1 ||
+	    SHA256_Update(&context, row_digest, sizeof(row_digest)) != 1 ||
+	    SHA256_Update(&context, node_digest, sizeof(node_digest)) != 1) return SLURM_ERROR;
+	return SHA256_Final(digest, &context) == 1 ? SLURM_SUCCESS : SLURM_ERROR;
+}
+
+extern int select_p_quota_partial_row_snapshot(job_record_t *target,
+		uint64_t generation, quota_partial_row_snapshot_t *snapshot)
+{
+	part_res_record_t *part;
+	quota_partial_row_snapshot_t result = {0};
+	if (!target || !snapshot || !generation || !target->details ||
