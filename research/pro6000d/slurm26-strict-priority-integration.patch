+#ifndef MONTHLY_REQUEUE_IDENTITY_H
+#define MONTHLY_REQUEUE_IDENTITY_H
+
+typedef struct {
+	char marker[33];
+	uint32_t restart;
+} mq_requeue_key_t;
+
+typedef enum {
+	MQ_RESERVATION_LEGACY = 0,
+	MQ_RESERVATION_REQUEUE = 1
+} mq_reservation_kind_t;
+
+typedef struct {
+	mq_reservation_kind_t kind;
+	mq_requeue_key_t requeue;
+} mq_reservation_key_t;
+
+typedef struct mq_requeue_intent {
+	uint32_t uid, job_id, old_restart, next_restart, tier, gpu, minutes;
+	uint32_t hold_month;
+	bool held;
+	uint64_t old_submit, old_sluid, old_generation, next_submit, next_sluid, amount;
+	char marker[33];
+	struct mq_requeue_intent *next;
+} mq_requeue_intent_t;
+
+static int mq_requeue_find(mq_requeue_intent_t *head, const mq_requeue_key_t *key,
+			   mq_requeue_intent_t **result)
+{
+	mq_requeue_intent_t *entry, *found = NULL;
+	if (!key || !result || !key->restart || strlen(key->marker) != 32 ||
+	    strspn(key->marker, "0123456789abcdef") != 32) return -1;
+	for (entry = head; entry; entry = entry->next) {
+		if (entry->next_restart != key->restart || strcmp(entry->marker, key->marker))
+			continue;
+		if (found) return -1;
+		found = entry;
+	}
+	*result = found;
+	return found ? 1 : 0;
+}
+
+static int mq_reservation_requeue_bind(mq_reservation_key_t *reservation,
+		mq_requeue_intent_t *head, const mq_requeue_key_t *key,
+		uint32_t uid, uint32_t job_id, uint64_t submit, uint64_t sluid,
+		uint32_t restart, uint32_t tier, uint64_t gpu)
+{
+	mq_requeue_intent_t *intent;
+	if (!reservation || mq_requeue_find(head, key, &intent) != 1 ||
+	    !intent->held || intent->uid != uid || intent->job_id != job_id ||
+	    intent->next_submit != submit || !sluid || intent->next_sluid != sluid ||
+	    intent->next_restart != restart || intent->tier != tier || intent->gpu != gpu)
+		return -1;
+	if (reservation->kind == MQ_RESERVATION_REQUEUE)
+		return reservation->requeue.restart == key->restart &&
+		       !strcmp(reservation->requeue.marker, key->marker) ? 0 : -1;
+	if (reservation->kind != MQ_RESERVATION_LEGACY) return -1;
+	reservation->kind = MQ_RESERVATION_REQUEUE;
+	reservation->requeue = *key;
+	return 0;
+}
+#endif
