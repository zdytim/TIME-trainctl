+
+extern int select_p_quota_partial_rollback_compare(job_record_t *target, uint64_t generation,
+		const unsigned char before[SHA256_DIGEST_LENGTH], bool rollback_succeeded)
+{
+	unsigned char after[SHA256_DIGEST_LENGTH];
+	if (!before || !rollback_succeeded ||
