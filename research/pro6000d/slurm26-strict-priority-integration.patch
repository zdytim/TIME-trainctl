+extern int select_p_quota_partial_gpu_job_hash(const job_record_t *job,
+		int node, const gres_state_t *entry,
+		unsigned char digest[SHA256_DIGEST_LENGTH])
+{
+	const gres_job_state_t *gres;
+	SHA256_CTX context;
+	uint64_t length, count, submit, sluid;
+	uint32_t offset = 0;
+	bitstr_t *bits;
+	if (!job || !entry || !digest || node < 0 || node >= node_record_count ||
+	    !entry->gres_name || strcmp(entry->gres_name, "gpu") ||
+	    entry->state_type != GRES_STATE_TYPE_JOB || !entry->gres_data ||
+	    (entry->config_flags & GRES_CONF_SHARED) || !job->job_id ||
+	    job->job_id == NO_VAL || job->user_id == NO_VAL || !job->details ||
+	    job->details->submit_time <= 0 || !job->step_id.sluid ||
+	    job->restart_cnt == NO_VAL16 || !job->job_resrcs ||
+	    !job->job_resrcs->node_bitmap ||
+	    bit_size(job->job_resrcs->node_bitmap) != node_record_count ||
+	    !bit_test(job->job_resrcs->node_bitmap, node) ||
+	    (!IS_JOB_RUNNING(job) && !IS_JOB_SUSPENDED(job))) return SLURM_ERROR;
+	gres = entry->gres_data;
+	if ((gres->flags & GRES_CONF_SHARED) || gres->gres_per_bit_alloc ||
+	    !gres->gres_bit_alloc || !gres->gres_cnt_node_alloc ||
+	    gres->node_cnt != job->job_resrcs->nhosts ||
+	    bit_set_count(job->job_resrcs->node_bitmap) != gres->node_cnt ||
+	    xsize(gres->gres_bit_alloc) / sizeof(*gres->gres_bit_alloc) < gres->node_cnt ||
+	    xsize(gres->gres_cnt_node_alloc) / sizeof(*gres->gres_cnt_node_alloc) < gres->node_cnt)
+		return SLURM_ERROR;
+	for (int previous = 0; previous < node; previous++)
+		if (bit_test(job->job_resrcs->node_bitmap, previous)) offset++;
+	if (offset >= gres->node_cnt || !(bits = gres->gres_bit_alloc[offset])) return SLURM_ERROR;
+	length = bit_size(bits); count = gres->gres_cnt_node_alloc[offset];
+	if (!length || !count || count != bit_set_count(bits)) return SLURM_ERROR;
+	submit = job->details->submit_time; sluid = job->step_id.sluid;
+	if (SHA256_Init(&context) != 1 ||
+	    SHA256_Update(&context, &node, sizeof(node)) != 1 ||
+	    SHA256_Update(&context, &job->user_id, sizeof(job->user_id)) != 1 ||
+	    SHA256_Update(&context, &job->job_id, sizeof(job->job_id)) != 1 ||
+	    SHA256_Update(&context, &sluid, sizeof(sluid)) != 1 ||
+	    SHA256_Update(&context, &submit, sizeof(submit)) != 1 ||
+	    SHA256_Update(&context, &job->restart_cnt, sizeof(job->restart_cnt)) != 1 ||
+	    SHA256_Update(&context, &entry->plugin_id, sizeof(entry->plugin_id)) != 1 ||
+	    SHA256_Update(&context, &gres->type_id, sizeof(gres->type_id)) != 1 ||
+	    SHA256_Update(&context, &length, sizeof(length)) != 1 ||
+	    SHA256_Update(&context, &count, sizeof(count)) != 1) return SLURM_ERROR;
+	for (uint64_t bit = 0; bit < length; bit++) {
+		unsigned char value = bit_test(bits, bit) ? 1 : 0;
+		if (SHA256_Update(&context, &value, sizeof(value)) != 1) return SLURM_ERROR;
+	}
+	return SHA256_Final(digest, &context) == 1 ? SLURM_SUCCESS : SLURM_ERROR;
+}
