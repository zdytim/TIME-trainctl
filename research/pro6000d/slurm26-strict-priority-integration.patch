+	    SHA256_Update(&context, &target->restart_cnt, sizeof(target->restart_cnt)) != 1 ||
+	    SHA256_Update(&context, &submit, sizeof(submit)) != 1 || SHA256_Update(&context, &sluid, sizeof(sluid)) != 1 ||
