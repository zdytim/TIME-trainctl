+int monthly_quota_top_requeue_guard(job_record_t *job)
+{
+	char marker_id[33];
+	enum time_tier tier;
+	mq_top_marker_t *marker;
+	int rc = -1;
+	if (!job || !monthly_top_job_write_locked()) return -1;
+	if (time_parse_job_marker(job->comment, marker_id, &tier)) return 0;
+	pthread_mutex_lock(&mq_lock);
+	mq_top_fenced = true;
+	if (!mq_enabled || !mq_healthy || !mq_reconciled || !mq_selectable_replay) goto out;
+	marker = _top_marker_find(marker_id);
+	if (!marker) {
+		if (_append_event("TOP_FENCE1|1"))
+			_mark_unhealthy("missing marker fence persistence failed");
+		else
+			_mark_unhealthy("requeue marker missing");
+		goto out;
+	}
+	if (!marker->started) { rc = marker->pending && marker->uid == job->user_id ? 0 : -1; goto out; }
+	if (marker->uid != job->user_id || marker->job_id != job->job_id ||
+	    !job->details || job->details->submit_time <= 0 ||
+	    marker->submit != (uint64_t)job->details->submit_time ||
+	    marker->sluid != job->step_id.sluid || marker->restart != job->restart_cnt ||
+	    !marker->generation) goto out;
+	if (!marker->requeue_guarded &&
+	    _append_event("TOP_REQUEUE_GUARD1|%u|%s|%u|%" PRIu64 "|%" PRIu64 "|%u|%" PRIu64,
+			  marker->uid, marker_id, marker->job_id, marker->submit,
+			  marker->sluid, marker->restart, marker->generation)) {
+		_mark_unhealthy("priority requeue guard persistence failed");
+		goto out;
+	}
+	marker->requeue_guarded = true;
+	mq_top_fenced = true;
+	rc = 0;
+out:
+	pthread_mutex_unlock(&mq_lock);
+	return rc;
+}
