+extern int select_p_quota_supplied_gpu_map_hash(int node, const gres_state_t *node_entry,
+		const char *node_name, uint64_t inventory_generation, const char *inventory_digest,
+		const quota_gpu_map_device_t *devices, size_t count, bool trusted,
+		unsigned char output[SHA256_DIGEST_LENGTH])
+{
+	const gres_node_state_t *gres;
+	SHA256_CTX context;
+	unsigned char item[SHA256_DIGEST_LENGTH];
+	list_itr_t *jobs, *entries;
+	job_record_t *job;
+	gres_state_t *entry;
+	int rc = SLURM_ERROR;
+	if (!trusted || !output || !node_name || !inventory_generation || !inventory_digest ||
+	    strnlen(inventory_digest, 65) != 64 || strspn(inventory_digest, "0123456789abcdef") != 64 ||
+	    !devices || !count || count > 4096 || !monthly_quota_node_write_locked() ||
+	    !monthly_top_job_write_locked() || node < 0 || node >= node_record_count ||
+	    !node_record_table_ptr || !node_record_table_ptr[node] || !node_record_table_ptr[node]->name ||
+	    strcmp(node_name, node_record_table_ptr[node]->name) ||
+	    select_p_quota_gpu_ownership_check(node, node_entry) != SLURM_SUCCESS) return SLURM_ERROR;
+	gres = node_entry->gres_data;
+	if (gres->gres_cnt_config != count || bit_size(gres->gres_bit_alloc) != count ||
+	    SHA256_Init(&context) != 1 || SHA256_Update(&context, &inventory_generation, sizeof(inventory_generation)) != 1 ||
+	    SHA256_Update(&context, inventory_digest, 64) != 1 ||
+	    SHA256_Update(&context, node_name, strlen(node_name) + 1) != 1 ||
+	    SHA256_Update(&context, &count, sizeof(count)) != 1) return SLURM_ERROR;
+	for (size_t index = 0; index < count; index++) {
+		if (devices[index].index != index || devices[index].minor != index ||
+		    devices[index].type_id != (gres->type_cnt ? gres->type_id[0] : 0) ||
+		    strnlen(devices[index].uuid, sizeof(devices[index].uuid)) != 40 ||
+		    strncmp(devices[index].uuid, "GPU-", 4) ||
+		    strspn(devices[index].uuid + 4, "0123456789abcdef-") != 36 ||
+		    devices[index].uuid[12] != '-' || devices[index].uuid[17] != '-' ||
+		    devices[index].uuid[22] != '-' || devices[index].uuid[27] != '-') return SLURM_ERROR;
+		for (size_t character = 4; character < 40; character++)
+			if (character != 12 && character != 17 && character != 22 && character != 27 &&
+			    devices[index].uuid[character] == '-') return SLURM_ERROR;
+		for (size_t prior = 0; prior < index; prior++)
+			if (devices[prior].minor == devices[index].minor || !strcmp(devices[prior].uuid, devices[index].uuid)) return SLURM_ERROR;
+		if (SHA256_Update(&context, &devices[index].index, sizeof(devices[index].index)) != 1 ||
+		    SHA256_Update(&context, &devices[index].minor, sizeof(devices[index].minor)) != 1 ||
+		    SHA256_Update(&context, &devices[index].type_id, sizeof(devices[index].type_id)) != 1 ||
+		    SHA256_Update(&context, devices[index].uuid, 40) != 1) return SLURM_ERROR;
+	}
+	if (select_p_quota_partial_gpu_node_hash(node_entry, item) != SLURM_SUCCESS || SHA256_Update(&context, item, sizeof(item)) != 1) return SLURM_ERROR;
+	jobs = list_iterator_create(job_list);
+	while ((job = list_next(jobs))) {
+		if (!IS_JOB_RUNNING(job) && !IS_JOB_SUSPENDED(job)) continue;
+		if (!job->job_resrcs || !job->job_resrcs->node_bitmap || !bit_test(job->job_resrcs->node_bitmap, node) || !job->gres_list_alloc) continue;
+		entries = list_iterator_create(job->gres_list_alloc);
+		while ((entry = list_next(entries))) {
+			if (select_p_quota_partial_gpu_job_hash(job, node, entry, item) != SLURM_SUCCESS || SHA256_Update(&context, item, sizeof(item)) != 1) {
+				list_iterator_destroy(entries); goto done;
+			}
+		}
+		list_iterator_destroy(entries);
+	}
+	if (SHA256_Final(output, &context) == 1) rc = SLURM_SUCCESS;
+done:
+	list_iterator_destroy(jobs);
+	return rc;
+}
