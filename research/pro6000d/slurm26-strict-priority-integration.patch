+extern int select_p_quota_partial_gpu_node_hash(const gres_state_t *entry,
+		unsigned char digest[SHA256_DIGEST_LENGTH])
+{
+	SHA256_CTX context;
+	const gres_node_state_t *node;
+	uint64_t length;
+	if (!entry || !digest || !entry->gres_name ||
+	    strcmp(entry->gres_name, "gpu") ||
+	    entry->state_type != GRES_STATE_TYPE_NODE || !entry->gres_data)
+		return SLURM_ERROR;
+	node = entry->gres_data;
+	if (node->no_consume || node->alt_gres || !node->gres_bit_alloc ||
+	    node->gres_cnt_alloc > node->gres_cnt_avail ||
+	    node->gres_cnt_avail > node->gres_cnt_config)
+		return SLURM_ERROR;
+	length = bit_size(node->gres_bit_alloc);
+	if (!length || node->gres_cnt_alloc != bit_set_count(node->gres_bit_alloc) ||
+	    node->gres_cnt_avail > length || SHA256_Init(&context) != 1 ||
+	    SHA256_Update(&context, &entry->plugin_id, sizeof(entry->plugin_id)) != 1 ||
+	    SHA256_Update(&context, &entry->config_flags, sizeof(entry->config_flags)) != 1 ||
+	    SHA256_Update(&context, &node->gres_cnt_config, sizeof(node->gres_cnt_config)) != 1 ||
+	    SHA256_Update(&context, &node->gres_cnt_avail, sizeof(node->gres_cnt_avail)) != 1 ||
+	    SHA256_Update(&context, &node->gres_cnt_alloc, sizeof(node->gres_cnt_alloc)) != 1 ||
+	    SHA256_Update(&context, &length, sizeof(length)) != 1)
+		return SLURM_ERROR;
+	for (uint64_t bit = 0; bit < length; bit++) {
+		unsigned char value = bit_test(node->gres_bit_alloc, bit) ? 1 : 0;
+		if (SHA256_Update(&context, &value, sizeof(value)) != 1)
+			return SLURM_ERROR;
+	}
+	return SHA256_Final(digest, &context) == 1 ? SLURM_SUCCESS : SLURM_ERROR;
+}
