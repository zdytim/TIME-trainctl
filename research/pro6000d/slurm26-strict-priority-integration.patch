+extern int select_p_quota_gpu_ownership_check(int node, const gres_state_t *node_entry)
+{
+	list_itr_t *jobs = NULL, *entries = NULL, *other_jobs = NULL, *other_entries = NULL;
+	job_record_t *job, *other;
+	gres_state_t *entry, *candidate;
+	const gres_node_state_t *node_gres;
+	list_t *node_list, *usage_list;
+	bitstr_t *owned = NULL;
+	unsigned char digest[SHA256_DIGEST_LENGTH];
+	int rc = SLURM_ERROR;
+	if (node < 0 || node >= node_record_count || !job_list || !select_node_usage ||
+	    !node_record_table_ptr || !node_record_table_ptr[node] || !node_entry ||
+	    select_p_quota_partial_gpu_node_hash(node_entry, digest) != SLURM_SUCCESS ||
+	    (node_entry->config_flags & GRES_CONF_SHARED)) return SLURM_ERROR;
+	usage_list = select_node_usage[node].gres_list;
+	node_list = node_record_table_ptr[node]->gres_list;
+	if ((usage_list && node_list && usage_list != node_list) || (!usage_list && !node_list))
+		return SLURM_ERROR;
+	entries = list_iterator_create(usage_list ? usage_list : node_list);
+	unsigned node_matches = 0;
+	while ((candidate = list_next(entries))) {
+		if (candidate == node_entry) node_matches++;
+		else { list_iterator_destroy(entries); return SLURM_ERROR; }
+	}
+	list_iterator_destroy(entries); entries = NULL;
+	if (node_matches != 1) return SLURM_ERROR;
+	node_gres = node_entry->gres_data;
+	if (node_gres->type_cnt > 1 ||
+	    (node_gres->type_cnt == 1 && (!node_gres->type_id ||
+	     xsize(node_gres->type_id) < sizeof(*node_gres->type_id) || !node_gres->type_id[0])) ||
+	    (node_gres->type_cnt == 0 && node_gres->type_id)) return SLURM_ERROR;
+	owned = bit_alloc(bit_size(node_gres->gres_bit_alloc));
+	jobs = list_iterator_create(job_list);
+	while ((job = list_next(jobs))) {
+		if (IS_JOB_COMPLETING(job) || (!IS_JOB_RUNNING(job) && !IS_JOB_SUSPENDED(job))) {
+			if (job->gres_list_alloc && list_count(job->gres_list_alloc)) goto out;
+			continue;
+		}
+		if (!job->job_resrcs || !job->job_resrcs->node_bitmap ||
+		    bit_size(job->job_resrcs->node_bitmap) != node_record_count) goto out;
+		if (!bit_test(job->job_resrcs->node_bitmap, node) || !job->gres_list_alloc) continue;
+		entries = list_iterator_create(job->gres_list_alloc);
+		while ((entry = list_next(entries))) {
+			gres_job_state_t *gres;
+			uint32_t offset = 0;
+			unsigned occurrences = 0;
+			bitstr_t *bits;
+			if (!entry->gres_name || strcmp(entry->gres_name, "gpu") ||
+			    entry->plugin_id != node_entry->plugin_id || !entry->gres_data ||
+			    select_p_quota_partial_gpu_job_hash(job, node, entry, digest) != SLURM_SUCCESS) goto out;
+			gres = entry->gres_data;
+			if (gres->type_id && (!node_gres->type_cnt ||
+			    gres->type_id != node_gres->type_id[0])) goto out;
+			other_jobs = list_iterator_create(job_list);
+			while ((other = list_next(other_jobs))) {
+				if (other != job && other->job_id == job->job_id) goto out;
+				if (!other->gres_list_alloc) continue;
+				other_entries = list_iterator_create(other->gres_list_alloc);
+				while ((candidate = list_next(other_entries))) if (candidate == entry) occurrences++;
+				list_iterator_destroy(other_entries); other_entries = NULL;
+			}
+			list_iterator_destroy(other_jobs); other_jobs = NULL;
+			if (occurrences != 1) goto out;
+			for (int prior = 0; prior < node; prior++)
+				if (bit_test(job->job_resrcs->node_bitmap, prior)) offset++;
+			bits = gres->gres_bit_alloc[offset];
+			if (bit_size(bits) != bit_size(owned) || bit_overlap_any(bits, owned)) goto out;
+			for (int bit = 0; bit < bit_size(bits); bit++)
+				if (bit_test(bits, bit) && !bit_test(node_gres->gres_bit_alloc, bit)) goto out;
+			bit_or(owned, bits);
+		}
+		list_iterator_destroy(entries); entries = NULL;
+	}
+	if (bit_equal(owned, node_gres->gres_bit_alloc)) rc = SLURM_SUCCESS;
+out:
+	if (other_entries) list_iterator_destroy(other_entries);
+	if (other_jobs) list_iterator_destroy(other_jobs);
+	if (entries) list_iterator_destroy(entries);
+	if (jobs) list_iterator_destroy(jobs);
+	FREE_NULL_BITMAP(owned);
+	return rc;
+}
