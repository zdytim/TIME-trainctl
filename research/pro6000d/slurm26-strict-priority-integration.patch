+/* Stage the exact replay on private lists before writing. The caller holds
+ * mq_lock, so no observer can see the temporary state. */
+static int _settle_release3(mq_active_record_t *active, const mq_time_t *to)
+{
+	char job[16], generation[32], sec[32], nsec[16];
+	char *fields[] = { NULL, NULL, NULL, job, generation, sec, nsec };
+	mq_active_record_t *old_a = mq_active, *a, *an;
+	mq_month_record_t *old_m = mq_months, *m, *mn;
+	mq_reserve1_t *old_r = mq_reserves, *r, *rn;
+	mq_active_record_t **atail;
+	mq_month_record_t **mtail;
+	mq_reserve1_t **rtail;
+	int rc;
+	snprintf(job, sizeof(job), "%u", active->job_id);
+	snprintf(generation, sizeof(generation), "%" PRIu64, active->generation);
+	snprintf(sec, sizeof(sec), "%" PRIu64, to->sec);
+	snprintf(nsec, sizeof(nsec), "%u", to->nsec);
+	mq_active = NULL; mq_months = NULL; mq_reserves = NULL;
+	atail = &mq_active; mtail = &mq_months; rtail = &mq_reserves;
+	for (a = old_a; a; a = a->next) {
+		an = xmalloc(sizeof(*an)); *an = *a; an->next = NULL; *atail = an; atail = &an->next;
+	}
+	for (m = old_m; m; m = m->next) {
+		mn = xmalloc(sizeof(*mn)); *mn = *m; mn->next = NULL; *mtail = mn; mtail = &mn->next;
+	}
+	for (r = old_r; r; r = r->next) {
+		rn = xmalloc(sizeof(*rn)); *rn = *r; rn->next = NULL; *rtail = rn; rtail = &rn->next;
+	}
+	rc = _replay_release3(fields, 7);
+	if (!rc)
+		rc = _append_event("RELEASE3|%s|%s|%s|%s", job, generation, sec, nsec);
+	if (rc) {
+		a = mq_active; m = mq_months; r = mq_reserves;
+		mq_active = old_a; mq_months = old_m; mq_reserves = old_r;
+	} else {
+		a = old_a; m = old_m; r = old_r;
+	}
+	while (a) { an = a->next; xfree(a); a = an; }
+	while (m) { mn = m->next; xfree(m); m = mn; }
+	while (r) { rn = r->next; xfree(r); r = rn; }
+	return rc;
+}
