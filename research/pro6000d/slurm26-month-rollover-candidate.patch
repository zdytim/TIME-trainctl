+/* Renew a held, unstarted request into the current month atomically. */
+int monthly_quota_roll1(uid_t uid, const char *request)
+{
+	mq_reserve1_t *entry;
+	struct job_record *job;
+	mq_time_t now;
+	uint32_t month;
+	uint64_t available;
+	int rc = -1;
+	if ((uid_t)(uint32_t)uid != uid || !_reserve1_request_valid(request)) return -1;
+	pthread_mutex_lock(&mq_lock);
+	if (!mq_enabled || !mq_healthy || !mq_reconciled || !mq_selectable_replay ||
+	    _now(&now) || _month_key(&now, &month) ||
+	    !(entry = _reserve1_find((uint32_t)uid, request)) || entry->terminal || entry->generation)
+		goto out;
+	if (entry->job_id) {
+		job = find_job_record(entry->job_id);
+		if (!job || job->user_id != uid || !IS_JOB_PENDING(job) || IS_JOB_COMPLETING(job))
+			goto out;
+	}
+	if (entry->month == month) { rc = 0; goto out; }
+	if (entry->month > month || _settle_all(&now) ||
+	    _reserve1_available(uid, month, entry->tier, &now, &available))
+		goto out;
+	if (entry->amount > available) { rc = -2; goto out; }
+	if (_append_event("ROLL1|%u|%s|%u|%u", (uint32_t)uid, request, entry->month, month)) {
+		_mark_unhealthy("reservation rollover persistence failed");
+		goto out;
+	}
+	entry->month = month;
 	rc = 0;
 out:
 	pthread_mutex_unlock(&mq_lock);
