--- a/src/slurmctld/monthly_quota.c
+++ b/src/slurmctld/monthly_quota.c
@@ -93,0 +94 @@
+	uint64_t sluid; /* Slurm 26 identity of this specific job run */
@@ -1053,0 +1055,3 @@
+#if defined(TIME_ENABLE_MONTHLY_SLUID_DRAFT) && TIME_ENABLE_MONTHLY_SLUID_DRAFT
+    if (!pending->sluid) return -1;
