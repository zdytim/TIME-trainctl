+/* Match the controller's comma/space delimited activation token exactly. */
+static bool _monthly_cleanup_marker_enabled(void)
+{
+	const char *cursor = slurm_conf.slurmctld_params, *start;
+	static const char token[] = "MonthlyGpuQuota";
+	if (!cursor)
+		return false;
+	while (*cursor) {
+		while (*cursor == ',' || *cursor == ' ' || *cursor == '\t') cursor++;
+		start = cursor;
+		while (*cursor && *cursor != ',' && *cursor != ' ' && *cursor != '\t') cursor++;
+		if ((size_t)(cursor - start) == sizeof(token) - 1 &&
+		    !strncasecmp(start, token, sizeof(token) - 1)) return true;
+	}
+	return false;
 }
