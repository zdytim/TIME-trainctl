+/* Node-written proof is root-owned and opened before dropping privilege.
+ * Match the complete allocation and termination identity, never just job ID. */
+static int _find_node_proof(const mq_active_record_t *active)
+{
+	static const char header[] = "P6NP1|HEADER|1\n";
+	struct stat st;
+	mq_time_t now;
+	FILE *stream = NULL;
+	char line[512];
+	size_t length;
+	int read_rc, result = 0, duplicate;
+	off_t next_offset;
+	if (mq_nodeproof_fd < 0 || _now(&now) || flock(mq_nodeproof_fd, LOCK_SH)) return -1;
+	if (fstat(mq_nodeproof_fd, &st) || st.st_size <= 0 || st.st_size < mq_nodeproof_offset ||
+	    lseek(mq_nodeproof_fd, mq_nodeproof_offset, SEEK_SET) < 0) {
+		flock(mq_nodeproof_fd, LOCK_UN); return -1;
+	}
+	duplicate = dup(mq_nodeproof_fd);
+	stream = duplicate >= 0 ? fdopen(duplicate, "r") : NULL;
+	if (!stream) {
+		if (duplicate >= 0) close(duplicate);
+		flock(mq_nodeproof_fd, LOCK_UN); return -1;
+	}
+	if (!mq_nodeproof_offset) {
+		if (_read_wal_line(stream, line, sizeof(line), &length) != 1 || strcmp(line, header) ||
+		    (next_offset = ftello(stream)) < 0) { result = -1; goto done; }
+		mq_nodeproof_offset = next_offset;
+	}
+	while ((read_rc = _read_wal_line(stream, line, sizeof(line), &length)) > 0) {
+		char *parts[11], *cursor, *item;
+		mq_active_record_t *candidate;
+		mq_time_t proof;
+		int count = 0;
+		uint32_t job, uid, state, exit_code, derived, nsec;
+		uint64_t sluid, start, sec;
+		line[length - 1] = '\0'; cursor = line;
+		while ((item = strsep(&cursor, "|")) && count < 11) parts[count++] = item;
+		if (item || cursor || count != 11 || strcmp(parts[0], "P6NP1") ||
+		    _parse_u32(parts[1], &job) || _parse_u64(parts[2], &sluid) || !sluid ||
+		    _parse_u32(parts[3], &uid) || _parse_u32(parts[4], &state) ||
+		    _parse_u32(parts[5], &exit_code) || _parse_u32(parts[6], &derived) ||
+		    _parse_u64(parts[7], &start) || _parse_u64(parts[8], &sec) ||
+		    _parse_u32(parts[9], &nsec) || nsec >= MQ_NSEC_PER_SEC || !_field_safe(parts[10])) {
+			result = -1; break;
+		}
+		candidate = _find_active_job(job);
+		if (candidate && candidate->sluid == sluid) {
+			if (!candidate->release_started || uid != candidate->uid ||
+			    state != candidate->final_state || exit_code != candidate->final_exit ||
+			    derived != candidate->final_derived || start != candidate->final_start ||
+			    sec < candidate->final_end || sec > now.sec ||
+			    (sec == now.sec && nsec > now.nsec) || strcmp(parts[10], candidate->final_node)) {
+				result = -1; break;
+			}
+			proof.sec = sec; proof.nsec = nsec;
+			if (!candidate->proof_seen || _time_cmp(&proof, &candidate->proof_at) < 0)
+				candidate->proof_at = proof;
+			candidate->proof_seen = true;
+		}
+		if ((next_offset = ftello(stream)) < 0) { result = -1; break; }
+		mq_nodeproof_offset = next_offset;
+	}
+	if (read_rc < 0) result = -1;
+	if (!result && active && active->proof_seen) result = 1;
+done:
+	fclose(stream);
+	flock(mq_nodeproof_fd, LOCK_UN);
+	return result;
 }
 
