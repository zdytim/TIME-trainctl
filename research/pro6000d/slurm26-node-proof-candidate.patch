+/* Root-owned append-only node evidence survives a lost controller reply.
+ * The private file is provisioned separately; never recreate it on error. */
+static int _monthly_write_node_proof(const kill_job_msg_t *req, bool reuse_only)
+{
+	static const char header[] = "P6NP1|HEADER|1\n";
+	const char *path = getenv("TIME_QUOTA_NODE_PROOF_FILE");
+	char *parent, *slash, buf[512], actual[sizeof(header) - 1];
+	struct stat directory, info;
+	struct timespec now;
+	int fd = -1, rc = -1, length;
+	size_t offset;
+	if (!path) path = "/var/lib/pro6000d-monthly/node-proof.wal";
+	if (path[0] != '/' || !req->step_id.sluid || !req->step_id.job_id ||
+	    req->start_time <= 0 || !conf->node_name || !conf->node_name[0] ||
+	    strpbrk(conf->node_name, "| \t\r\n")) return -1;
+	parent = xstrdup(path);
+	slash = strrchr(parent, '/');
+	if (!slash || slash == parent) goto out;
+	*slash = '\0';
+	if (lstat(parent, &directory) || !S_ISDIR(directory.st_mode) ||
+	    directory.st_uid != 0 || (directory.st_mode & 0077)) goto out;
+	fd = open(path, O_RDWR | O_APPEND | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0 || fstat(fd, &info) || !S_ISREG(info.st_mode) || info.st_uid != 0 ||
+	    info.st_nlink != 1 || (info.st_mode & 0077) ||
+	    pread(fd, actual, sizeof(actual), 0) != sizeof(actual) ||
+	    memcmp(actual, header, sizeof(actual)) || flock(fd, LOCK_EX) ||
+	    clock_gettime(CLOCK_REALTIME, &now) || now.tv_sec < req->start_time || now.tv_nsec < 0)
+		goto out;
+	if (reuse_only) {
+		FILE *stream;
+		char line[512], prefix[384], *end;
+		int copy_fd = dup(fd), prefix_len;
+		bool found = false, valid = true;
+		unsigned long long sec, nsec;
+		if (copy_fd < 0 || lseek(copy_fd, 0, SEEK_SET) < 0 || !(stream = fdopen(copy_fd, "r"))) {
+			if (copy_fd >= 0) close(copy_fd);
+			goto out;
+		}
+		prefix_len = snprintf(prefix, sizeof(prefix), "P6NP1|%u|%" PRIu64 "|%u|%u|%u|%u|%" PRIu64 "|",
+				      req->step_id.job_id, (uint64_t)req->step_id.sluid,
+				      req->job_uid, req->job_state, req->exit_code,
+				      req->derived_ec, (uint64_t)req->start_time);
+		if (prefix_len <= 0 || prefix_len >= (int)sizeof(prefix) ||
+		    !fgets(line, sizeof(line), stream) || strcmp(line, header)) valid = false;
+		while (valid && fgets(line, sizeof(line), stream)) {
+			size_t len = strlen(line);
+			if (!len || line[len - 1] != '\n' || strncmp(line, "P6NP1|", 6)) { valid = false; break; }
+			if (strncmp(line, prefix, prefix_len)) continue;
+			errno = 0; sec = strtoull(line + prefix_len, &end, 10);
+			if (errno || end == line + prefix_len || *end++ != '|') { valid = false; break; }
+			char *nsec_start = end;
+			errno = 0; nsec = strtoull(nsec_start, &end, 10);
+			if (errno || end == nsec_start || *end++ != '|' || nsec >= 1000000000ULL ||
+			    sec < (uint64_t)req->start_time || sec > (uint64_t)now.tv_sec ||
+			    (sec == (uint64_t)now.tv_sec && nsec > (uint64_t)now.tv_nsec) ||
+			    strlen(end) != strlen(conf->node_name) + 1 ||
+			    strncmp(end, conf->node_name, strlen(conf->node_name)) || end[strlen(conf->node_name)] != '\n') {
+				valid = false; break;
+			}
+			found = true;
+		}
+		if (ferror(stream)) valid = false;
+		fclose(stream);
+		if (valid && found && !fsync(fd)) rc = 0;
+		goto out;
+	}
+	length = snprintf(buf, sizeof(buf), "P6NP1|%u|%" PRIu64 "|%u|%u|%u|%u|%" PRIu64 "|%" PRIu64 "|%u|%s\n",
+			  req->step_id.job_id, (uint64_t)req->step_id.sluid, req->job_uid,
+			  req->job_state, req->exit_code, req->derived_ec, (uint64_t)req->start_time,
+			  (uint64_t)now.tv_sec, (unsigned)now.tv_nsec, conf->node_name);
+	if (length <= 0 || length >= (int)sizeof(buf)) goto out;
+	for (offset = 0; offset < (size_t)length;) {
+		ssize_t n = write(fd, buf + offset, (size_t)length - offset);
+		if (n < 0 && errno == EINTR) continue;
+		if (n <= 0) goto out;
+		offset += n;
+	}
+	if (!fsync(fd)) rc = 0;
+out:
+	if (fd >= 0) close(fd);
+	xfree(parent);
+	return rc;
 }
