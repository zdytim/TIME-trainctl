+#if defined(TIME_ENABLE_MONTHLY_COMMIT5_DRAFT) && TIME_ENABLE_MONTHLY_COMMIT5_DRAFT
+/* COMMIT5 is an experimental, unused transaction format. The pending
+ * allocation is excluded while previously committed jobs are advanced to
+ * the allocation boundary, then it joins their common accounting clock. */
+static int _commit5_validate(mq_active_record_t *pending, const mq_time_t *at)
+{
+    mq_active_record_t *other;
+    mq_reserve1_t *reservation;
+    uint32_t month;
+    bool found = false;
@@ -1036,0 +1048,34 @@
+    if (!pending || !at || pending->committed || !pending->identity_bound ||
+        !pending->reservation_bound || at->nsec >= MQ_NSEC_PER_SEC ||
+        _time_cmp(at, &pending->anchor) < 0 || _month_key(at, &month))
+        return -1;
+    reservation = _reserve1_find(pending->uid, pending->marker_id);
+    if (!reservation || reservation->job_id != pending->job_id ||
+        reservation->generation != pending->generation || reservation->month != month)
+        return -1;
+    for (other = mq_active; other; other = other->next) {
+        if (other == pending) { found = true; continue; }
+        if (!other->committed || _time_cmp(&other->anchor, &pending->anchor))
+            return -1;
+    }
+    return found ? 0 : -1;
+}
+
+static int _commit5_apply(mq_active_record_t *pending, const mq_time_t *at)
+{
+    mq_active_record_t **link;
+    int rc;
+
+    if (_commit5_validate(pending, at)) return -1;
+    for (link = &mq_active; *link != pending; link = &(*link)->next) { }
+    *link = pending->next;
+    rc = mq_active ? _replay_selectable_advance(at) : 0;
+    pending->next = *link;
+    *link = pending;
+    if (rc) return -1;
+    pending->anchor = *at;
+    pending->committed = true;
+    return 0;
+}
+#endif
