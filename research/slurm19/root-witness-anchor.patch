+/* The descriptor was opened and locked by the root launcher before the
+ * controller dropped privileges. Append + fsync is part of each transaction. */
+static int _append_witness(uint64_t seq, const unsigned char digest[SHA256_DIGEST_LENGTH])
+{
+	char line[160], hex[SHA256_DIGEST_LENGTH * 2 + 1];
+	static const char digits[] = "0123456789abcdef";
+	ssize_t n;
+	size_t i, offset = 0;
+	int len;
+	if (mq_witness_fd < 0) return -1;
+	for (i = 0; i < SHA256_DIGEST_LENGTH; i++) {
+		hex[i * 2] = digits[digest[i] >> 4];
+		hex[i * 2 + 1] = digits[digest[i] & 15];
+	}
+	hex[sizeof(hex) - 1] = '\0';
+	len = snprintf(line, sizeof(line), "U20MQA1|%" PRIu64 "|%s\n", seq, hex);
+	if (len <= 0 || (size_t)len >= sizeof(line)) return -1;
+	while (offset < (size_t)len) {
+		n = write(mq_witness_fd, line + offset, (size_t)len - offset);
+		if (n < 0 && errno == EINTR) continue;
+		if (n <= 0) return -1;
+		offset += (size_t)n;
+	}
+	return fsync(mq_witness_fd) == 0 ? 0 : -1;
+}
