+/* Compare the current candidate and all remaining queued users against one
+ * fresh ledger snapshot. Return 1 if current, 0 if stale, -1 if unavailable.
+ * Unknown ordering stops the pass; allocation has its own independent gate. */
+extern int monthly_quota_queue_current(List job_queue, job_queue_rec_t *current)
+{
+	ListIterator iter;
+	job_queue_rec_t *rec;
+	uid_t *uids;
+	monthly_quota_tier_t *tiers, expected;
+	struct timeval now;
+	size_t count, i;
+	int matches = 1;
+
+	if (!current)
+		return -1;
+	if (!monthly_quota_enabled())
+		return 1;
+	count = (size_t)list_count(job_queue) + 1;
+	if (gettimeofday(&now, NULL) || now.tv_sec < 0)
+		return -1;
+	uids = xcalloc(count, sizeof(*uids));
+	tiers = xcalloc(count, sizeof(*tiers));
+	uids[0] = current->job_ptr->user_id;
+	iter = list_iterator_create(job_queue);
+	for (i = 1; i < count && (rec = list_next(iter)); i++)
+		uids[i] = rec->job_ptr->user_id;
+	list_iterator_destroy(iter);
+	if (i != count || monthly_quota_tiers_at(uids, count,
+			(uint64_t)now.tv_sec, (uint32_t)now.tv_usec * 1000, tiers)) {
+		matches = -1;
+		goto out;
+	}
+	expected = gres_get_job_state(current->job_ptr->gres_list, "gpu") ?
+		tiers[0] : MONTHLY_QUOTA_NORMAL;
+	if (current->monthly_tier != expected) {
+		matches = 0;
+		goto out;
+	}
+	iter = list_iterator_create(job_queue);
+	for (i = 1; i < count && (rec = list_next(iter)); i++) {
+		expected = gres_get_job_state(rec->job_ptr->gres_list, "gpu") ?
+			tiers[i] : MONTHLY_QUOTA_NORMAL;
+		if (rec->monthly_tier != expected) {
+			matches = 0;
+			break;
+		}
+	}
+	list_iterator_destroy(iter);
+out:
+	xfree(tiers);
+	xfree(uids);
+	return matches;
 }
 
