+    def monthly_request(self, requested: Any) -> Dict[str, Any]:
+        if not isinstance(requested, dict):
+            raise ApiError(400, "invalid_monthly_request", "月度申请必须是对象")
+        hours, month, key = requested.get("gpu_hours"), requested.get("month"), requested.get("client_request_id")
+        now = dt.datetime.now(dt.timezone(dt.timedelta(hours=8)))
+        if isinstance(hours, bool) or not isinstance(hours, int) or not 1 <= hours <= 100000:
+            raise ApiError(400, "invalid_gpu_hours", "追加 GPU 小时必须为 1 至 100000 的整数")
+        if isinstance(month, bool) or not isinstance(month, int) or month != now.year * 100 + now.month:
+            raise ApiError(409, "month_changed", "请刷新并申请本月额度")
+        if not isinstance(key, str) or not re.fullmatch(r"[A-Za-z0-9-]{8,80}", key):
+            raise ApiError(400, "request_id_required", "月度申请需要稳定请求编号")
+        return {"gpu_hours": hours, "month": month, "client_request_id": key}
