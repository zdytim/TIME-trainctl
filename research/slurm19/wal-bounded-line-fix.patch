+/* The writer's line buffer is 1024 bytes. Bound recovery memory to the same
+ * maximum and reject incomplete, oversized or binary records. */
+static int _read_wal_line(FILE *stream, char *line, size_t size, size_t *length)
+{
+	size_t used = 0;
+	int ch;
+
+	while ((ch = fgetc(stream)) != EOF) {
+		if (ch == '\0' || used >= size - 1)
+			return -1;
+		line[used++] = (char)ch;
+		if (ch == '\n') {
+			line[used] = '\0';
+			*length = used;
+			return 1;
+		}
+	}
+	return (ferror(stream) || used) ? -1 : 0;
 }
 
