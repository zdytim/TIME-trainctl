+/* Convert without truncation. This transition is accepted only with no active
+ * allocations and is not yet activatable: the V2 writer and replay are not
+ * implemented. The old WAL remains intact and is still protected by its
+ * checkpoint and witness. */
+static int _legacy_to_selectable(mq_amount_t value, uint64_t *out)
+{
+    if (!out || value.nsec >= MQ_NSEC_PER_SEC ||
+        value.sec > (UINT64_MAX - value.nsec) / MQ_NSEC_PER_SEC)
+        return -1;
+    *out = value.sec * (uint64_t) MQ_NSEC_PER_SEC + value.nsec;
+    return 0;
+}
+
+static int _replay_selectable_cutover(void)
+{
+    mq_month_record_t *record;
+    struct time_tier_balance converted;
+    uint64_t usage, grants;
+    if (mq_selectable_replay || mq_active)
+        return -1;
+    /* Validate every account before changing any in-memory record. */
+    for (record = mq_months; record; record = record->next) {
+        if (_legacy_to_selectable(record->usage, &usage) ||
+            _legacy_to_selectable(record->grants, &grants) ||
+            time_tier_import_legacy(&converted, usage, grants))
+            return -1;
+    }
+    for (record = mq_months; record; record = record->next) {
+        if (_legacy_to_selectable(record->usage, &usage) ||
+            _legacy_to_selectable(record->grants, &grants) ||
+            time_tier_import_legacy(&record->selectable, usage, grants))
+            return -1;
+    }
+    mq_selectable_replay = true;
+    return 0;
+}
