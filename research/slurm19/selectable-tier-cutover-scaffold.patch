+/* Freeze per-job selected tier and current eligibility for one sorting pass.
+ * The authoritative allocation gate is checked separately under mq_lock. */
+int monthly_quota_jobs_tiers_at(struct job_record *const *jobs, size_t count,
+                                uint64_t sec, uint32_t nsec,
+                                monthly_quota_tier_t *tiers)
+{
+	mq_time_t now = { .sec = sec, .nsec = nsec };
+	monthly_quota_tier_t *snapshot;
+	struct time_tier_balance balance;
+	enum time_tier selected;
+	char marker[33];
+	size_t i;
+	int eligible, rc = -1;
+	if (nsec >= MQ_NSEC_PER_SEC || (count && (!jobs || !tiers)) ||
+	    count > SIZE_MAX / sizeof(*snapshot)) return -1;
+	snapshot = count ? malloc(count * sizeof(*snapshot)) : NULL;
+	if (count && !snapshot) return -1;
+	pthread_mutex_lock(&mq_lock);
+	if (!mq_enabled || !mq_healthy || !mq_reconciled) goto out;
+	for (i = 0; i < count; i++) {
+		if (!jobs[i]) { snapshot[i] = MONTHLY_QUOTA_NORMAL; continue; }
+		if (!mq_selectable_replay) {
+			if (_tier_locked(jobs[i]->user_id, &now, &snapshot[i])) goto out;
+			continue;
+		}
+		if (time_parse_job_marker(jobs[i]->comment, marker, &selected) ||
+		    _project_selectable_user(jobs[i]->user_id, &now, &balance) ||
+		    (eligible = time_tier_eligible(&balance, selected)) < 0) goto out;
+		snapshot[i] = eligible ? (monthly_quota_tier_t)selected : MONTHLY_QUOTA_EXHAUSTED;
+	}
+	if (count) memcpy(tiers, snapshot, count * sizeof(*tiers));
+	rc = 0;
+out:
+	pthread_mutex_unlock(&mq_lock);
+	free(snapshot);
+	return rc;
+}
