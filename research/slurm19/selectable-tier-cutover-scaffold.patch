+int monthly_quota_snapshot2(uid_t uid, monthly_quota_snapshot2_t *out)
+{
+	monthly_quota_snapshot2_t result;
+	struct time_tier_balance balance;
+	mq_month_record_t *record;
+	mq_active_record_t *active;
+	mq_time_t now;
+	unsigned i;
+	int rc = -1;
+	if (!out || (uid_t)(uint32_t)uid != uid) return -1;
+	memset(&result, 0, sizeof(result));
+	pthread_mutex_lock(&mq_lock);
+	if (!mq_enabled || !mq_healthy || !mq_reconciled || !mq_selectable_replay ||
+	    _now(&now) || _month_key(&now, &result.month) ||
+	    _project_selectable_user((uint32_t)uid, &now, &balance)) goto out;
+	record = _find_month((uint32_t)uid, result.month, false);
+	if (record) { result.granted.sec = record->grants.sec; result.granted.nsec = record->grants.nsec; }
+	for (i = 0; i < TIME_TIER_COUNT; i++) {
+		result.used[i].sec = balance.used[i] / MQ_NSEC_PER_SEC;
+		result.used[i].nsec = balance.used[i] % MQ_NSEC_PER_SEC;
+	}
+	result.overage.sec = balance.overage / MQ_NSEC_PER_SEC;
+	result.overage.nsec = balance.overage % MQ_NSEC_PER_SEC;
