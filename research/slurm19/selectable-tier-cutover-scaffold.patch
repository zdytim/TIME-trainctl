+		if (active->uid != (uint32_t)uid) continue;
+		if (!active->committed || result.active_allocation_count == UINT32_MAX ||
+		    UINT64_MAX - result.active_gpu_count < active->gpu_count) goto out;
+		result.active_allocation_count++;
+		result.active_gpu_count += active->gpu_count;
+	}
+	result.observed_sec = now.sec; result.observed_nsec = now.nsec;
+	result.wal_sequence = mq_seq;
+	*out = result;
+	rc = 0;
+out:
+	pthread_mutex_unlock(&mq_lock);
+	return rc;
+}
