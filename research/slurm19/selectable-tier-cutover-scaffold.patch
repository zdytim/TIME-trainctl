+/* V2 replay-only advancement. The controller still rejects V2 WALs at
+ * completion until writer, scheduling and recovery are all integrated. */
+static int _compare_tier_jobs(const void *left, const void *right)
+{
+    const struct time_active_job *a = left, *b = right;
+    if (a->job_id != b->job_id) return a->job_id < b->job_id ? -1 : 1;
+    if (a->generation != b->generation) return a->generation < b->generation ? -1 : 1;
+    return 0;
+}
+
+static int _replay_selectable_advance(const mq_time_t *end)
+{
+    mq_active_record_t *a, *b;
+    mq_time_t cursor, boundary, next;
+    mq_amount_t duration;
+    uint64_t nanos;
+    uint32_t month;
+    unsigned count, i;
+    struct time_active_job *jobs;
+    mq_month_record_t *record;
+
+    if (!mq_active) return -1;
+    cursor = mq_active->anchor;
+    for (a = mq_active; a; a = a->next)
+        if (!a->committed || _time_cmp(&a->anchor, &cursor) ||
+            _time_cmp(&cursor, end) > 0) return -1;
+    while (_time_cmp(&cursor, end) < 0) {
+        if (_month_key(&cursor, &month) || _next_month_boundary(&cursor, &boundary))
+            return -1;
+        next = _time_cmp(&boundary, end) < 0 ? boundary : *end;
+        if (_duration(&cursor, &next, &duration) ||
+            _legacy_to_selectable(duration, &nanos)) return -1;
+        for (a = mq_active; a; a = a->next) {
+            /* Process each user exactly once per interval. */
+            for (b = mq_active; b != a; b = b->next)
+                if (b->uid == a->uid) break;
+            if (b != a) continue;
+            count = 0;
+            for (b = mq_active; b; b = b->next)
+                if (b->uid == a->uid && ++count > 4096) return -1;
+            jobs = xcalloc(count, sizeof(*jobs));
+            i = 0;
+            for (b = mq_active; b; b = b->next) {
+                if (b->uid != a->uid) continue;
+                jobs[i].job_id = b->job_id; jobs[i].generation = b->generation;
+                jobs[i].current = b->current_tier; jobs[i].gpu_count = b->gpu_count;
+                i++;
+            }
+            qsort(jobs, count, sizeof(*jobs), _compare_tier_jobs);
+            record = _find_month(a->uid, month, true);
+            if (!record || time_tier_advance(&record->selectable, jobs, count, nanos)) {
+                xfree(jobs); return -1;
+            }
+            for (i = 0; i < count; i++) {
+                b = _find_active(jobs[i].job_id, jobs[i].generation);
+                if (!b) { xfree(jobs); return -1; }
+                b->current_tier = jobs[i].current;
+            }
+            xfree(jobs);
+        }
+        cursor = next;
+    }
+    for (a = mq_active; a; a = a->next) a->anchor = *end;
+    return 0;
+}
