+/* Project one user's V2 balances without writing WAL or mutating live state.
+ * The caller holds mq_lock; V2 active allocations share a settled anchor. */
+static int _project_selectable_user(uint32_t uid, const mq_time_t *now,
+                                    struct time_tier_balance *out)
+{
+	mq_active_record_t *a;
+	mq_month_record_t *record;
+	struct time_active_job *jobs = NULL;
+	struct time_tier_balance balance;
+	mq_time_t cursor, boundary, next;
+	mq_amount_t duration;
+	uint64_t nanos;
+	uint32_t month;
+	unsigned count = 0, i = 0;
+	int rc = -1;
+
+	for (a = mq_active; a; a = a->next)
+		if (a->uid == uid && ++count > 4096) return -1;
+	if (!count) {
+		if (_month_key(now, &month)) return -1;
+		record = _find_month(uid, month, false);
+		return record ? (*out = record->selectable, 0) :
+			time_tier_import_legacy(out, 0, 0);
+	}
+	jobs = xcalloc(count, sizeof(*jobs));
+	cursor = mq_active->anchor;
+	for (a = mq_active; a; a = a->next) {
+		if (!a->committed || _time_cmp(&a->anchor, &cursor) ||
+		    _time_cmp(&cursor, now) > 0) goto out;
+		if (a->uid != uid) continue;
+		jobs[i].job_id = a->job_id; jobs[i].generation = a->generation;
+		jobs[i].current = a->current_tier; jobs[i].gpu_count = a->gpu_count;
+		i++;
+	}
+	qsort(jobs, count, sizeof(*jobs), _compare_tier_jobs);
+	while (_time_cmp(&cursor, now) < 0) {
+		if (_month_key(&cursor, &month) || _next_month_boundary(&cursor, &boundary)) goto out;
+		next = _time_cmp(&boundary, now) < 0 ? boundary : *now;
+		if (_duration(&cursor, &next, &duration) || _legacy_to_selectable(duration, &nanos)) goto out;
+		record = _find_month(uid, month, false);
+		if (record) balance = record->selectable;
+		else if (time_tier_import_legacy(&balance, 0, 0)) goto out;
+		if (time_tier_advance(&balance, jobs, count, nanos)) goto out;
+		cursor = next;
+		/* A boundary belongs to the following month. */
+		if (_time_cmp(&cursor, now) == 0 && _time_cmp(&cursor, &boundary) != 0) {
+			*out = balance; rc = 0; goto out;
+		}
+	}
+	if (_month_key(now, &month)) goto out;
+	record = _find_month(uid, month, false);
+	if (record) *out = record->selectable;
+	else if (time_tier_import_legacy(out, 0, 0)) goto out;
+	rc = 0;
+out:
+	xfree(jobs);
+	return rc;
+}
