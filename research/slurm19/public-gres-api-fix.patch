+/* Enumerate public Slurm plugin IDs before using the type-sensitive lookup.
+ * Return -1 for unsupported/ambiguous GPU shapes, 0 for no relevant GRES,
+ * and 1 for a single untyped GPU record. */
+static int _quota_gpu_shape(List gres_list, gres_job_state_t **gpu)
+{
+	uint32_t *ids;
+	uint64_t *values;
+	int count, i, found = 0, result = -1;
+
+	*gpu = NULL;
+	if (!gres_list || !(count = list_count(gres_list)))
+		return 0;
+	if (count < 0 || count > 1024)
+		return -1;
+	ids = xcalloc(count, sizeof(*ids));
+	values = xcalloc(count, sizeof(*values));
+	if (gres_plugin_job_count(gres_list, count, ids, values) != SLURM_SUCCESS)
+		goto out;
+	for (i = 0; i < count; i++) {
+		if (ids[i] == gres_plugin_build_id("mps") ||
+		    ids[i] == gres_plugin_build_id("shard") ||
+		    ids[i] == gres_plugin_build_id("mig"))
+			goto out;
+		if (ids[i] == gres_plugin_build_id("gpu"))
+			found++;
+	}
+	if (found > 1)
+		goto out;
+	if (!found) {
+		result = 0;
+		goto out;
+	}
+	*gpu = gres_get_job_state(gres_list, "gpu");
+	if (!*gpu || (*gpu)->type_name) {
+		*gpu = NULL;
+		goto out;
+	}
+	result = 1;
+out:
+	xfree(ids);
+	xfree(values);
+	return result;
+}
