+/* A stale control socket is recoverable only while this controller owns
+ * a healthy reconciled ledger and its exclusive WAL/checkpoint locks. */
+bool monthly_quota_control_recovery_ready(void)
+{
+	bool ready;
+	pthread_mutex_lock(&mq_lock);
+	ready = mq_enabled && mq_healthy && mq_reconciled &&
+		(mq_fd >= 0) && (mq_checkpoint_fd >= 0);
+	pthread_mutex_unlock(&mq_lock);
+	return ready;
+}
