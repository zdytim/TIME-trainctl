 extern void sort_job_queue(List job_queue)
 {
+	ListIterator iter;
+	job_queue_rec_t *rec;
+	uid_t *uids;
+	monthly_quota_tier_t *tiers;
+	struct timeval now;
+	size_t count, i;
+
+	/* Each entry has a fixed value throughout sorting, including CPU-only
+	 * jobs. Never read the changing ledger from the comparator itself. */
+	count = list_count(job_queue);
+	iter = list_iterator_create(job_queue);
+	while ((rec = list_next(iter)))
+		rec->monthly_tier = MONTHLY_QUOTA_NORMAL;
+	list_iterator_destroy(iter);
+	if (monthly_quota_enabled() && count && !gettimeofday(&now, NULL) &&
+	    now.tv_sec >= 0) {
+		uids = xcalloc(count, sizeof(*uids));
+		tiers = xcalloc(count, sizeof(*tiers));
+		iter = list_iterator_create(job_queue);
+		for (i = 0; i < count && (rec = list_next(iter)); i++)
+			uids[i] = rec->job_ptr->user_id;
+		list_iterator_destroy(iter);
+		if (i == count && !monthly_quota_tiers_at(
+			    uids, count, (uint64_t)now.tv_sec,
+			    (uint32_t)now.tv_usec * 1000, tiers)) {
+			iter = list_iterator_create(job_queue);
+			for (i = 0; i < count && (rec = list_next(iter)); i++) {
+				/* CPU-only work uses the neutral normal tier. */
+				if (gres_get_job_state(rec->job_ptr->gres_list, "gpu"))
+					rec->monthly_tier = tiers[i];
+			}
+			list_iterator_destroy(iter);
+		}
+		xfree(tiers);
+		xfree(uids);
+	}
 	list_sort(job_queue, sort_job_queue2);
 }
 
