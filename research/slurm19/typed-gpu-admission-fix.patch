+/* Inspect plugin identity rather than type_name: gres_get_job_state("gpu")
+ * does not match typed GPU records. Return -1 for unsupported/ambiguous GPU
+ * shapes, 0 for no relevant GRES, 1 for a single untyped GPU record. */
+extern int gres_job_quota_gpu_shape(List gres_list, gres_job_state_t **gpu)
+{
+	ListIterator iter;
+	gres_state_t *entry;
+	int result = 0;
+	uint32_t gpu_id = gres_plugin_build_id("gpu");
+	uint32_t mps_id = gres_plugin_build_id("mps");
+	uint32_t shard_id = gres_plugin_build_id("shard");
+	uint32_t mig_id = gres_plugin_build_id("mig");
+
+	if (!gpu)
+		return -1;
+	*gpu = NULL;
+	if (!gres_list)
+		return 0;
+	slurm_mutex_lock(&gres_context_lock);
+	iter = list_iterator_create(gres_list);
+	while ((entry = list_next(iter))) {
+		gres_job_state_t *data = entry->gres_data;
+		if (!data) {
+			result = -1;
+			break;
+		}
+		if (entry->plugin_id == mps_id || entry->plugin_id == shard_id ||
+		    entry->plugin_id == mig_id) {
+			result = -1;
+			break;
+		}
+		if (entry->plugin_id != gpu_id)
+			continue;
+		if (result || data->type_name ||
+		    (data->gres_name && strcmp(data->gres_name, "gpu"))) {
+			result = -1;
+			break;
+		}
+		*gpu = data;
+		result = 1;
+	}
+	list_iterator_destroy(iter);
+	slurm_mutex_unlock(&gres_context_lock);
+	if (result < 0)
+		*gpu = NULL;
+	return result;
+}
