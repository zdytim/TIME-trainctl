+++ b/src/slurmctld/monthly_quota.h
@@ -0,0 +1,61 @@
+/*****************************************************************************\
+ *  monthly_quota.h - controller-side monthly GPU quota admission ledger
+ *
+ *  This module is deliberately private to slurmctld.  It is disabled unless
+ *  the exact SlurmctldParameters token MonthlyGpuQuota is present.
+\*****************************************************************************/
+
+#ifndef _HAVE_SLURMCTLD_MONTHLY_QUOTA_H
+#define _HAVE_SLURMCTLD_MONTHLY_QUOTA_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+#include "src/common/list.h"
+
+struct job_record;
+
+/*
+ * Return values for the read-only and prepare calls:
+ *   1  quota applies and the operation is allowed
+ *   0  quota is disabled or the job has no supported GPU allocation
+ *  -1  quota applies and the operation is denied/fail-closed
+ */
+extern int monthly_quota_check(struct job_record *job_ptr,
+			       uint64_t *tres_req_cnt, bool test_only,
+			       bool preemption_candidate);
+
+/* On success this leaves the ledger mutex held until commit/abort/ambiguous. */
+extern int monthly_quota_begin(struct job_record *job_ptr,
+			       uint64_t *tres_req_cnt);
+extern int monthly_quota_commit(struct job_record *job_ptr);
+extern void monthly_quota_abort(struct job_record *job_ptr);
+extern void monthly_quota_ambiguous(struct job_record *job_ptr);
+
+/* Close the allocation only after Slurm has completed its release path. */
+extern void monthly_quota_release(struct job_record *job_ptr);
+
+/* cons_tres retains GRES during suspension; GPU accounting continues. */
+extern void monthly_quota_suspend(struct job_record *job_ptr, bool indefinite);
+extern void monthly_quota_resume(struct job_record *job_ptr, bool indefinite);
+
+/* Running/suspended resize is unsupported while the gate is active. */
+extern bool monthly_quota_job_resize_denied(struct job_record *job_ptr,
+						bool resize_request);
+
+/* Called after job/select/GRES state has been restored, before scheduling. */
+extern int monthly_quota_reconcile(List job_list);
+extern void monthly_quota_fini(void);
+extern bool monthly_quota_enabled(void);
+
+/*
+ * Controller-only grant primitive.  No user-facing RPC is added by this
+ * patch; an authenticated administrative caller must supply a stable,
+ * pipe-free idempotency key and actor string before using it.
+ */
+extern int monthly_quota_grant(uid_t uid, uint32_t month,
+			       uint64_t gpu_seconds, const char *grant_id,
+			       const char *actor);
+
+#endif /* _HAVE_SLURMCTLD_MONTHLY_QUOTA_H */
