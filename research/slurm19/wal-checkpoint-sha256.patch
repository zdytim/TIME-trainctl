+/* Recompute a digest over the complete locked WAL without changing its
+ * append offset. Coordinated rollback of both files remains out of scope. */
+static int _hash_wal(unsigned char digest[SHA256_DIGEST_LENGTH])
+{
+	char block[8192];
+	off_t offset = 0;
+	ssize_t n;
+	SHA256_CTX finalized;
+	if (SHA256_Init(&mq_wal_digest) != 1)
+		return -1;
+	for (;;) {
+		do { n = pread(mq_fd, block, sizeof(block), offset); }
+		while (n < 0 && errno == EINTR);
+		if (n < 0) return -1;
+		if (n == 0) break;
+		if (offset > INT64_MAX - n || SHA256_Update(&mq_wal_digest, block, (size_t)n) != 1)
+			return -1;
+		offset += n;
+	}
+	finalized = mq_wal_digest;
+	return SHA256_Final(digest, &finalized) == 1 ? 0 : -1;
+}
+
+/* Reject old, incomplete, sequence-mismatched or content-mismatched state. */
