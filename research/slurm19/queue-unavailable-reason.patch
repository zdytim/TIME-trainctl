+
+/* Scheduling cannot determine GPU queue order without a current quota
+ * snapshot. Preserve an explicit reason rather than a stale selection result.
+ * Both callers hold the controller job write lock. */
+static void _monthly_quota_mark_unavailable(struct job_record *job_ptr)
+{
+	const char *reason = "MonthlyGpuQuota:quota state or ordering unavailable";
+	if (!job_ptr || !IS_JOB_PENDING(job_ptr) ||
+	    !gres_get_job_state(job_ptr->gres_list, "gpu"))
+		return;
+	if (job_ptr->state_reason == WAIT_ACCOUNT_POLICY && job_ptr->state_desc &&
+	    !strcmp(job_ptr->state_desc, reason))
+		return;
+	job_ptr->state_reason = WAIT_ACCOUNT_POLICY;
+	xfree(job_ptr->state_desc);
+	job_ptr->state_desc = xstrdup(reason);
+	last_job_update = time(NULL);
 }
 
+static void _monthly_quota_queue_unavailable(List queue, job_queue_rec_t *current)
+{
+	ListIterator iter;
+	job_queue_rec_t *rec;
+	_monthly_quota_mark_unavailable(current->job_ptr);
+	iter = list_iterator_create(queue);
+	while ((rec = list_next(iter)))
+		_monthly_quota_mark_unavailable(rec->job_ptr);
+	list_iterator_destroy(iter);
+}
+
 /* Compare the current candidate and all remaining queued users against one
