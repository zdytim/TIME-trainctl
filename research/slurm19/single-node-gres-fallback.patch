+		/* Slurm 19 without an accounting provider can omit gpu TRES.
+		 * Support only the exact single-node per-node GPU shape here.
+		 * Before allocation, require the selector's count at the chosen
+		 * node to agree with both the request and its aggregate. After
+		 * allocation/recovery, require the recorded allocation to agree.
+		 * Any unsupported or unclear shape remains pending. */
+		uint64_t count;
+		int index;
+		bitstr_t *nodes = job_ptr->job_resrcs ?
+			job_ptr->job_resrcs->node_bitmap : NULL;
+
+		if (!gpu_state->gres_per_node || gpu_state->gres_per_job ||
+		    gpu_state->gres_per_socket || gpu_state->gres_per_task) {
+			*why = "GPU request shape needs accounting TRES";
+			return -1;
+		}
+		if (allocated) {
+			if (gpu_state->node_cnt != 1 || !gpu_state->gres_cnt_node_alloc) {
+				*why = "single-node GPU allocation is not provable";
+				return -1;
+			}
+			count = gpu_state->gres_cnt_node_alloc[0];
+		} else {
+			if (!nodes || bit_set_count(nodes) != 1 ||
