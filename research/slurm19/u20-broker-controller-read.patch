+    def controller_monthly_snapshot(self, uid: int) -> Dict[str, Any]:
+        # An absent or unavailable controller is never reported as zero usage.
+        config = self.config.get("monthly_controller", {})
+        if not isinstance(config, dict) or not config.get("read_enabled", False):
+            return {"state": "unknown", "enforcement_ready": False,
+                    "reason": "controller quota snapshot is not configured"}
+        try:
+            controller = pwd.getpwnam(config.get("controller_user", "slurm"))
+            bridge = ControllerBridge(config.get("socket_path", "/var/lib/slurm/ctld/time-quota.sock"),
+                                      controller.pw_uid)
+            return {"state": "observed", "enforcement_ready": False,
+                    "snapshot": bridge.snapshot(uid),
+                    "reason": "controller snapshot is staged; enforcement not verified"}
+        except (KeyError, ControllerUnavailable, ValueError, TypeError):
+            return {"state": "unknown", "enforcement_ready": False,
+                    "reason": "controller quota snapshot unavailable"}
 
